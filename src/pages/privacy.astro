---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="プライバシーポリシー | NOUVATION">
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>

  <Header />
  
  <main class="pt-24 md:pt-32 bg-[#F6F6EE] min-h-screen">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 pb-24">
      <h1 class="text-2xl md:text-3xl font-bold text-center mb-12 text-[#231815]">
        プライバシーポリシー
      </h1>

      <div class="bg-white rounded-3xl shadow-sm overflow-hidden">
        <img 
          src="/images/privacy_policy.jpg" 
          alt="" 
          class="hidden md:block w-full h-auto"
          role="presentation"
        />
        <img 
          src="/images/privacy_policy_sp.jpg" 
          alt="" 
          class="block md:hidden w-full h-auto"
          role="presentation"
        />
      </div>
      
      <div class="mt-8 text-center">
        <a href="/" class="text-[#2e7d32] font-bold hover:underline">トップページへ戻る</a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
