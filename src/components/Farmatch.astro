---
// farmatch Section - 耕作放棄地マッチングプラットフォーム | Premium Futuristic
---

<section data-section-theme="dark" id="farmatch" class="fm-section">
  <!-- 背景レイヤー -->
  <div class="fm-bg" aria-hidden="true">
    <div class="fm-bg__gradient"></div>
    <div class="fm-bg__noise"></div>
    <div class="fm-bg__glow fm-bg__glow--1"></div>
    <div class="fm-bg__glow fm-bg__glow--2"></div>
    <div class="fm-bg__scan"></div>
  </div>

  <div class="fm-container">
    <!-- Main Title -->
    <div class="fm-title-wrap" data-fm>
      <h2 class="fm-title">
        <span class="fm-fa">farm</span><span class="fm-ma">a</span><span class="fm-fa">tch</span>
      </h2>
      <p class="fm-subtitle">耕作放棄地マッチングプラットフォーム</p>
    </div>

    <!-- Hero Copy -->
    <div class="fm-hero" data-fm>
      <h3 class="fm-hero__jp">
        眠っている農地を、<br />
        次の挑戦の場所へ。
      </h3>
      <p class="fm-hero__desc">
        農地を持て余す地主と、農業を始めたい就農希望者を<br class="pc" />
        直接つなぐ、新しい仕組み。
      </p>
    </div>

    <!-- Main Layout: Stat + Reel -->
    <div class="fm-main">
      <!-- Left: Stat + Problem -->
      <div class="fm-left">
        <!-- Stat -->
        <div class="fm-stat" data-fm>
          <p class="fm-stat__label">日本の耕作放棄地</p>
          <div class="fm-stat__value">
            <span class="fm-stat__num">42.3</span>
            <span class="fm-stat__unit">万ha</span>
          </div>
          <div class="fm-stat__bar">
            <div class="fm-stat__bar-fill"></div>
          </div>
          <p class="fm-stat__note">このミスマッチを放置すれば、<br />地域の農業は、静かに消えていく。</p>
        </div>

        <!-- Problems -->
        <div class="fm-problems">
          <div class="fm-prob" data-fm>
            <div class="fm-prob__head">
              <span class="fm-prob__tag">地主</span>
              <span class="fm-prob__arrow">›</span>
            </div>
            <p class="fm-prob__text">農地があるのに、農業ができない。</p>
          </div>
          <div class="fm-prob" data-fm>
            <div class="fm-prob__head">
              <span class="fm-prob__tag">就農希望者</span>
              <span class="fm-prob__arrow">›</span>
            </div>
            <p class="fm-prob__text">農業したいのに、農地がない。</p>
          </div>
        </div>
      </div>

      <!-- Right: Instagram Reel -->
      <div class="fm-reel-wrap" data-fm>
        <div class="fm-reel-frame">
          <div class="fm-reel-glow"></div>
          <div class="fm-reel-inner">
            <blockquote
              class="instagram-media"
              data-instgrm-permalink="https://www.instagram.com/reel/DWyLXf6ih7t/"
              data-instgrm-version="14"
              style="background:transparent; border:0; border-radius:0; margin:0; width:100%; min-width:100%;"
            ></blockquote>
          </div>
          <div class="fm-reel-corner fm-reel-corner--tl"></div>
          <div class="fm-reel-corner fm-reel-corner--tr"></div>
          <div class="fm-reel-corner fm-reel-corner--bl"></div>
          <div class="fm-reel-corner fm-reel-corner--br"></div>
        </div>
        <p class="fm-reel-caption">
          <span class="fm-dot"></span>
          @nouvation_official
        </p>
      </div>
    </div>

    <!-- CTA -->
    <div class="fm-cta" data-fm>
      <a href="https://farmatch.jp" target="_blank" rel="noopener noreferrer" class="fm-cta__btn">
        <span class="fm-cta__label">farmatch.jpで詳しく見る</span>
        <span class="fm-cta__arrow">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </span>
      </a>
      <p class="fm-cta__note">
        <span class="fm-cta__dot"></span>
        地主・就農希望者、どちらも無料でご利用いただけます
      </p>
    </div>
  </div>

  <script is:inline src="//www.instagram.com/embed.js" async></script>
</section>

<style>
  .fm-section {
    position: relative;
    padding: 3rem 0 3.5rem;
    overflow: hidden;
    isolation: isolate;
  }

  /* ========== Background ========== */
  .fm-bg { position: absolute; inset: 0; pointer-events: none; z-index: 0; }

  .fm-bg__gradient {
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse 80% 60% at 20% 0%, rgba(40, 80, 30, 0.4) 0%, transparent 50%),
      radial-gradient(ellipse 70% 60% at 80% 100%, rgba(30, 60, 25, 0.4) 0%, transparent 50%),
      linear-gradient(180deg, #0a0f08 0%, #0d1508 50%, #0a0f08 100%);
  }

  .fm-bg__noise {
    position: absolute; inset: 0;
    opacity: 0.15;
    background-image:
      radial-gradient(circle at 10% 20%, rgba(255,255,255,0.02) 0%, transparent 5%),
      radial-gradient(circle at 80% 40%, rgba(255,255,255,0.02) 0%, transparent 5%),
      radial-gradient(circle at 40% 80%, rgba(255,255,255,0.02) 0%, transparent 5%);
  }

  .fm-bg__grid {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(200,255,120,0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(200,255,120,0.025) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 50%, black 10%, transparent 80%);
  }

  .fm-bg__glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
  }
  .fm-bg__glow--1 {
    width: 500px; height: 500px;
    top: 10%; left: -10%;
    background: rgba(100, 200, 60, 0.15);
    animation: fmFloat1 18s ease-in-out infinite;
  }
  .fm-bg__glow--2 {
    width: 450px; height: 450px;
    bottom: 5%; right: -8%;
    background: rgba(180, 230, 100, 0.1);
    animation: fmFloat2 22s ease-in-out infinite;
  }
  @keyframes fmFloat1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(40px, 60px) scale(1.15); }
  }
  @keyframes fmFloat2 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-50px, -40px) scale(1.1); }
  }

  .fm-bg__scan {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(180, 255, 100, 0.5), transparent);
    animation: fmScan 8s linear infinite;
  }
  @keyframes fmScan {
    0% { transform: translateY(0); opacity: 0; }
    10% { opacity: 1; }
    90% { opacity: 1; }
    100% { transform: translateY(100vh); opacity: 0; }
  }

  /* ========== Container ========== */
  .fm-container {
    position: relative;
    z-index: 1;
    max-width: 960px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* ========== Badge ========== */
  .fm-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 1.1rem;
    background: rgba(180, 255, 100, 0.08);
    border: 1px solid rgba(180, 255, 100, 0.25);
    border-radius: 100px;
    margin-bottom: 2rem;
    backdrop-filter: blur(12px);
  }
  .fm-badge__pulse {
    position: relative;
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #b4ff64;
    box-shadow: 0 0 12px rgba(180, 255, 100, 0.8);
  }
  .fm-badge__pulse::after {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 1px solid rgba(180, 255, 100, 0.5);
    animation: fmPulse 2s ease-in-out infinite;
  }
  @keyframes fmPulse {
    0% { transform: scale(1); opacity: 1; }
    100% { transform: scale(2.5); opacity: 0; }
  }
  .fm-badge__text {
    font-size: 0.62rem;
    letter-spacing: 0.28em;
    font-weight: 700;
    color: #b4ff64;
  }

  /* ========== Title ========== */
  .fm-title-wrap { margin-bottom: 1.2rem; }

  .fm-title {
    font-size: clamp(1.8rem, 5vw, 3rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 0.9;
    margin-bottom: 0.8rem;
    display: flex;
    align-items: baseline;
    gap: 0;
  }
  .fm-fa {
    background: linear-gradient(180deg, #fafaf4 0%, #e8e8dc 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .fm-ma {
    background: linear-gradient(180deg, #d4ff4e 0%, #a8e830 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-shadow: 0 0 40px rgba(180, 255, 100, 0.4);
    position: relative;
    display: inline-block;
  }
  .fm-ma::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, transparent, #b4ff64, transparent);
    opacity: 0.6;
  }

  .fm-subtitle {
    font-size: clamp(0.75rem, 1.6vw, 0.88rem);
    letter-spacing: 0.35em;
    color: rgba(250, 250, 244, 0.45);
    font-weight: 500;
    text-transform: uppercase;
  }

  /* ========== Hero ========== */
  .fm-hero {
    margin-bottom: 1.8rem;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid rgba(180, 255, 100, 0.1);
    position: relative;
  }
  .fm-hero::after {
    content: '';
    position: absolute;
    bottom: -1px; left: 0;
    width: 80px; height: 1px;
    background: linear-gradient(90deg, #b4ff64, transparent);
  }

  .fm-hero__jp {
    font-family: 'Shippori Mincho', 'YuMincho', serif;
    font-size: clamp(1.3rem, 3vw, 1.8rem);
    font-weight: 800;
    line-height: 1.55;
    color: #fafaf4;
    margin-bottom: 1.5rem;
    text-shadow: 0 2px 40px rgba(0, 0, 0, 0.5);
  }

  .fm-hero__desc {
    font-size: clamp(0.88rem, 1.8vw, 1rem);
    line-height: 2.1;
    color: rgba(250, 250, 244, 0.65);
    letter-spacing: 0.02em;
  }

  /* ========== Main Layout ========== */
  .fm-main {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-bottom: 1.5rem;
    align-items: start;
  }

  /* ========== Stat ========== */
  .fm-stat {
    padding: 1.8rem 1.6rem;
    background: linear-gradient(160deg, rgba(255,255,255,0.04), rgba(255,255,255,0.01));
    border: 1px solid rgba(180, 255, 100, 0.15);
    border-radius: 1rem;
    backdrop-filter: blur(16px);
    margin-bottom: 1.5rem;
    position: relative;
    overflow: hidden;
  }
  .fm-stat::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(180, 255, 100, 0.4), transparent);
  }

  .fm-stat__label {
    font-size: 0.65rem;
    letter-spacing: 0.25em;
    color: rgba(250, 250, 244, 0.45);
    margin-bottom: 0.8rem;
    text-transform: uppercase;
  }

  .fm-stat__value {
    display: flex;
    align-items: flex-end;
    gap: 0.4rem;
    margin-bottom: 1.5rem;
  }
  .fm-stat__num {
    font-family: 'Shippori Mincho', serif;
    font-size: clamp(2.8rem, 7vw, 4.2rem);
    font-weight: 800;
    line-height: 0.95;
    background: linear-gradient(180deg, #d4ff4e 0%, #8cc828 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-shadow: 0 0 60px rgba(180, 255, 100, 0.3);
    letter-spacing: -0.02em;
  }
  .fm-stat__unit {
    font-size: clamp(1.1rem, 2.5vw, 1.6rem);
    font-weight: 700;
    color: rgba(250, 250, 244, 0.55);
    padding-bottom: 0.5rem;
  }

  .fm-stat__bar {
    width: 100%;
    height: 3px;
    background: rgba(180, 255, 100, 0.1);
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 1.2rem;
  }
  .fm-stat__bar-fill {
    height: 100%;
    width: 85%;
    background: linear-gradient(90deg, #b4ff64, #7ac020);
    box-shadow: 0 0 12px rgba(180, 255, 100, 0.4);
    animation: fmBarFill 2s cubic-bezier(0.22,1,0.36,1) 0.3s both;
    transform-origin: left;
  }
  @keyframes fmBarFill {
    0% { transform: scaleX(0); }
    100% { transform: scaleX(1); }
  }

  .fm-stat__note {
    font-size: 0.8rem;
    line-height: 1.85;
    color: rgba(250, 250, 244, 0.65);
  }

  /* ========== Problems ========== */
  .fm-problems {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .fm-prob {
    padding: 1.1rem 1.3rem;
    background: linear-gradient(160deg, rgba(255,255,255,0.03), rgba(255,255,255,0.005));
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-left: 2px solid rgba(180, 255, 100, 0.4);
    border-radius: 0.5rem;
    transition: all 0.3s ease;
  }
  .fm-prob:hover {
    border-left-color: #b4ff64;
    background: linear-gradient(160deg, rgba(180,255,100,0.06), rgba(255,255,255,0.01));
    transform: translateX(4px);
  }

  .fm-prob__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.4rem;
  }
  .fm-prob__tag {
    font-size: 0.58rem;
    letter-spacing: 0.22em;
    color: #b4ff64;
    font-weight: 700;
    text-transform: uppercase;
  }
  .fm-prob__arrow {
    color: rgba(180, 255, 100, 0.5);
    font-size: 1.1rem;
    line-height: 1;
  }

  .fm-prob__text {
    font-family: 'Shippori Mincho', serif;
    font-size: clamp(0.95rem, 2vw, 1.08rem);
    font-weight: 700;
    color: #fafaf4;
    line-height: 1.5;
  }

  /* ========== Reel ========== */
  .fm-reel-wrap {
    position: relative;
    max-width: 320px;
    margin: 0 auto;
  }

  .fm-reel-frame {
    position: relative;
    padding: 1rem;
    background: linear-gradient(160deg, rgba(255,255,255,0.04), rgba(255,255,255,0.01));
    border: 1px solid rgba(180, 255, 100, 0.15);
    border-radius: 1.2rem;
    backdrop-filter: blur(16px);
  }

  .fm-reel-glow {
    position: absolute;
    inset: -1px;
    border-radius: 1.2rem;
    background: linear-gradient(120deg, transparent 40%, rgba(180, 255, 100, 0.3) 50%, transparent 60%);
    background-size: 200% 200%;
    animation: fmShimmer 6s ease-in-out infinite;
    opacity: 0.5;
    pointer-events: none;
    z-index: -1;
  }
  @keyframes fmShimmer {
    0%, 100% { background-position: -100% -100%; }
    50% { background-position: 100% 100%; }
  }

  .fm-reel-inner {
    position: relative;
    border-radius: 0.7rem;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.2);
  }

  .fm-reel-inner :global(.instagram-media) {
    max-width: 100% !important;
    min-width: auto !important;
    border-radius: 0.7rem !important;
  }

  .fm-reel-corner {
    position: absolute;
    width: 16px; height: 16px;
    border-color: #b4ff64;
    border-style: solid;
    border-width: 0;
  }
  .fm-reel-corner--tl { top: 0; left: 0; border-top-width: 2px; border-left-width: 2px; border-top-left-radius: 4px; }
  .fm-reel-corner--tr { top: 0; right: 0; border-top-width: 2px; border-right-width: 2px; border-top-right-radius: 4px; }
  .fm-reel-corner--bl { bottom: 0; left: 0; border-bottom-width: 2px; border-left-width: 2px; border-bottom-left-radius: 4px; }
  .fm-reel-corner--br { bottom: 0; right: 0; border-bottom-width: 2px; border-right-width: 2px; border-bottom-right-radius: 4px; }

  .fm-reel-caption {
    margin-top: 0.9rem;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    color: rgba(250, 250, 244, 0.45);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    justify-content: center;
  }
  .fm-dot {
    width: 5px; height: 5px;
    border-radius: 50%;
    background: #b4ff64;
    box-shadow: 0 0 8px rgba(180, 255, 100, 0.6);
    animation: fmDot 2s ease-in-out infinite;
  }
  @keyframes fmDot {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  /* ========== CTA ========== */
  .fm-cta {
    text-align: center;
  }

  .fm-cta__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    padding: 1.2rem 2.5rem 1.2rem 2.8rem;
    background: linear-gradient(135deg, #d4ff4e 0%, #a8e830 100%);
    color: #0a0f08;
    border-radius: 100px;
    font-size: 1rem;
    font-weight: 800;
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    box-shadow:
      0 8px 32px rgba(180, 255, 100, 0.25),
      0 0 0 1px rgba(180, 255, 100, 0.3) inset;
    margin-bottom: 1.3rem;
    position: relative;
    overflow: hidden;
  }
  .fm-cta__btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, transparent 30%, rgba(255,255,255,0.3) 50%, transparent 70%);
    background-size: 200% 200%;
    background-position: 100% 100%;
    transition: background-position 0.8s ease;
  }
  .fm-cta__btn:hover {
    transform: translateY(-3px);
    box-shadow:
      0 16px 50px rgba(180, 255, 100, 0.4),
      0 0 0 1px rgba(180, 255, 100, 0.5) inset;
  }
  .fm-cta__btn:hover::before {
    background-position: -100% -100%;
  }
  .fm-cta__label { position: relative; z-index: 1; }
  .fm-cta__arrow {
    display: inline-flex;
    position: relative;
    z-index: 1;
    transition: transform 0.35s cubic-bezier(0.22,1,0.36,1);
  }
  .fm-cta__btn:hover .fm-cta__arrow {
    transform: translateX(5px);
  }

  .fm-cta__note {
    font-size: 0.75rem;
    color: rgba(250, 250, 244, 0.45);
    line-height: 1.8;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .fm-cta__dot {
    width: 5px; height: 5px;
    border-radius: 50%;
    background: rgba(180, 255, 100, 0.5);
  }

  /* ========== Scroll Reveal ========== */
  [data-fm] {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.85s cubic-bezier(0.22, 1, 0.36, 1),
                transform 0.85s cubic-bezier(0.22, 1, 0.36, 1);
  }
  [data-fm].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ========== Responsive ========== */
  @media (max-width: 900px) {
    .fm-section { padding: 5rem 0 6rem; }
    .fm-main {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .fm-hero { margin-bottom: 3rem; padding-bottom: 2rem; }
    .pc { display: none; }
  }
</style>

<script>
  const fmObs = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('is-visible'); });
  }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
  document.querySelectorAll('[data-fm]').forEach(el => fmObs.observe(el));
</script>
