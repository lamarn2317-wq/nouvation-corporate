---
// FAQ Component
// 型定義を追加
interface FAQItem {
  question: string;
  answer: string;
  isExpandable?: boolean; // ? をつけることで、あってもなくても良い（オプショナル）にする
}

interface FAQGroup {
  title: string;
  items: FAQItem[];
}

const faqGroups: FAQGroup[] = [
  {
    title: "", // 全般
    items: [
      {
        question: 'Q. NOUVATIONとはなんですか？',
        answer: 'A. 仮テキスト'
      },
      {
        question: 'Q. 何ができますか？',
        answer: 'A. 仮テキスト'
      }
    ]
  },
  {
    title: "農業AIサポートに関するQ＆A",
    items: [
      {
        question: 'Q. 農業AIサポートは何ができますか？',
        answer: 'A. 仮テキスト'
      }
    ]
  },
  {
    title: "市場価格に関するQ＆A",
    items: [
      {
        question: 'Q. 表示している価格は「高値・中値・安値」のどれですか？',
        answer: `A. NOUVATIONの市場価格速報は、「市場内の相対取引」をベースにした参考価格です。
※契約単価・生産価格を保証するものではありません。

全国主要7市場の取引情報をもとに、原則として 1kgあたりの「中値」を基準に表示しています。

掲載する産地は、取引量が多い主要産地を優先しています。
なお、データ上「中値」が確認できない場合に限り、代替指標として「高値」を表示することがあります。

※相対取引価格は、等級・階級（例：大玉/中玉）、荷姿、出荷ロット等の条件により変動します。`,
        isExpandable: true
      }
    ]
  },
  {
    title: "法人・提携に関するQ＆A",
    items: [
      {
        question: 'Q. 企業・団体との提携やスポンサー相談はできますか？',
        answer: 'A. 仮テキスト'
      }
    ]
  }
];
---

<section data-section-theme="light" class="py-24 md:py-32 bg-[#F6F6EE]">
  <div class="max-w-3xl mx-auto px-4 sm:px-6">
    <!-- Section Title -->
    <h2 class="text-3xl md:text-5xl font-bold text-center mb-16 leading-[1.2] text-[#231815] fade-up">
      <span class="font-maru">Q&A</span>
    </h2>

    <!-- FAQ Items -->
    <div class="space-y-12">
      {faqGroups.map((group) => (
        <div class="fade-up">
          {group.title && (
            <h3 class="text-sm font-bold text-[#2e7d32] mb-6 flex items-center">
              <span class="w-1 h-4 bg-[#2e7d32] mr-2"></span>
              {group.title}
            </h3>
          )}
          <div class="space-y-4">
            {group.items.map((item) => (
              <div class="bg-white border border-[#231815]/10 rounded-2xl p-6 md:p-8 hover:shadow-md transition-shadow">
                <h4 class="font-bold text-[#231815] mb-3 text-base md:text-lg">{item.question}</h4>
                
                {item.isExpandable ? (
                  <details class="group">
                    <summary class="list-none cursor-pointer text-[#2e7d32] text-sm font-bold flex items-center group-open:mb-4">
                      <span>詳細を見る</span>
                      <svg class="w-4 h-4 ml-1 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                      </svg>
                    </summary>
                    <div class="text-sm md:text-base text-[#231815] leading-loose opacity-80 whitespace-pre-wrap border-t border-[#231815]/5 pt-4">
                      {item.answer}
                    </div>
                  </details>
                ) : (
                  <p class="text-sm md:text-base text-[#231815] leading-loose opacity-80 whitespace-pre-wrap">{item.answer}</p>
                )}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
