---

<section data-section-theme="light" class="pt-16 md:pt-24 pb-24 md:pb-32 bg-[#F6F6EE]">
  <div class="max-w-3xl mx-auto px-4 sm:px-6">
    <!-- Section Title -->
    <h2 class="text-4xl md:text-[5rem] font-bold text-center mb-16 leading-[1.2] text-[#231815] fade-up">
      <span class="font-maru">Q&A</span>
    </h2>

    <!-- FAQ Items -->
    <div class="space-y-12">
      {faqGroups.map((group) => (
        <div class="fade-up">
          {group.title && (
            <h3 class="text-sm font-bold text-[#2e7d32] mb-6 flex items-center">
              <span class="w-1 h-4 bg-[#2e7d32] mr-2"></span>
              {group.title}
            </h3>
          )}
          <div class="space-y-4">
            {group.items.map((item) => (
              <div class="bg-white border border-[#231815]/10 rounded-2xl p-6 md:p-8 hover:shadow-md transition-shadow">
                <h4 class="font-bold text-[#231815] mb-3 text-base md:text-lg">{item.question}</h4>
                
                {item.isExpandable ? (
                  <details class="group">
                    <summary class="list-none cursor-pointer text-[#2e7d32] text-sm font-bold flex items-center group-open:mb-4">
                      <span>回答を見る</span>
                      <svg class="w-4 h-4 ml-1 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                      </svg>
                    </summary>
                    <div class="faq-answer text-sm md:text-base text-[#231815] leading-loose opacity-80 whitespace-pre-wrap border-t border-[#231815]/5 pt-4">
                      {item.answer}

                      {item.ctaText && (
                        <div class="mt-8">
                          <a
                            href={item.ctaLink}
                            class="inline-block bg-[#2e7d32] text-white px-8 py-4 rounded-full font-bold text-sm md:text-base hover:-translate-y-0.5 transition-all shadow-md hover:shadow-lg"
                          >
                            {item.ctaText}
                          </a>
                        </div>
                      )}
                    </div>
                  </details>
                ) : (
                  <p class="text-sm md:text-base text-[#231815] leading-loose opacity-80 whitespace-pre-wrap">{item.answer}</p>
                )}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .faq-note {
    font-size: 0.8rem !important;
    color: #555 !important;
    display: inline-block;
    margin-top: 0.2rem;
  }
</style>

<script is:inline>
  (function(){
    var done = false;
    function run() {
      if (done) return;
      var els = document.querySelectorAll('.faq-answer');
      if (els.length === 0) return;
      done = true;
      els.forEach(function(el) {
        var html = el.innerHTML;
        // エスケープされた<a>タグを復元
        html = html.replace(
          /&lt;a\s+([\s\S]*?)&gt;([\s\S]*?)&lt;\/a&gt;/g,
          function(match, attrs, text) {
            var decoded = attrs
              .replace(/&quot;/g, '"')
              .replace(/&#39;/g, "'")
              .replace(/&amp;/g, '&');
            return '<a ' + decoded + '>' + text + '</a>';
          }
        );
        // ※注釈をグレー小文字化
        html = html.replace(
          /(※[^\n<]+)/g,
          '<span class="faq-note">$1</span>'
        );
        el.innerHTML = html;
      });
    }
    // 複数タイミングで試行
    run();
    setTimeout(run, 500);
    setTimeout(run, 1500);
    setTimeout(run, 3000);
    document.addEventListener('DOMContentLoaded', run);
    document.addEventListener('astro:page-load', run);
  })();
</script>
