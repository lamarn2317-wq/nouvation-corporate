---
// FAQ Component

// 型定義を追加
interface FAQItem {
  question: string;
  answer: string;
  isExpandable?: boolean;
  ctaText?: string;
  ctaLink?: string;
}

interface FAQGroup {
  title: string;
  items: FAQItem[];
}

const faqGroups: FAQGroup[] = [
  {
    title: "", // 全般
    items: [
      {
        question: 'Q. NOUVATIONとはなんですか？',
        answer: 'A. 仮テキスト'
      },
      {
        question: 'Q. 何ができますか？',
        answer: 'A. 仮テキスト'
      }
    ]
  },
  {
    title: "農業AIサポートに関するQ＆A",
    items: [
      {
        question: 'Q. 農業AIサポートは何ができますか？',
        answer: `A. LINE×AIで、あなた専属の「営農パートナー」を雇えます。

まるで友達に質問するように。あなたのLINEに、専属の営農コンサルを。
栽培の悩みから経営相談まで、NOUVATIONのマスコットキャラクター「ノヴェル君」が即答。
あなたの地域や作物を学習し、使えば使うほど「あなた専用」のアドバイスができるようになります。

【具体的な3つのサポート】

1. 現場の疑問を「2秒」で解決
病害虫対策や栽培方法、天気予報（OpenWeather社データ）など、作業の手を止めずにその場で解決できます。

2. 経営と収益の相談
補助金情報（Jグランツ）の案内や経営改善の壁打ちに加え、「契約販売の仲介サポート（優先枠）」※も提供。作るだけでなく「売る」まで支援します。

3. あなたに寄り添うメンタルケア
ユーザーの「都道府県」や「育てている作物」を学習。名前を呼んで励ましてくれたり、たまに関西弁で話しかけたりと、孤独になりがちな農作業の精神的な支えになります。

【料金・お試し】

通常月額 1,980円のところ、ローンチキャンペーンにつき【先着100名様限定】で月額 1,480円（永年適用）でご利用可能です。
※101名様以降は条件が変更となります。今後、機能拡充（画像診断等）により定価が値上げされた場合も、本枠で登録された方は現在の価格のままご利用いただけます。

※契約販売は確約ではありませんが、料理人や飲食店様から「野菜の要望」があった際に、会員様へ優先的にオファー（マッチング）をご案内する仕組みです。すでに成約実績もございます。`,
        isExpandable: true,
        ctaText: "まずは5通無料で試してみる",
        ctaLink: "#" // 適切なリンク先に変更してください
      }
    ]
  },
  {
    title: "市場価格に関するQ＆A",
    items: [
      {
        question: 'Q. 表示している価格は「高値・中値・安値」のどれですか？',
        answer: `A. NOUVATIONの市場価格速報は、「市場内の相対取引」をベースにした参考価格です。
※契約単価・生産価格を保証するものではありません。

全国主要7市場の取引情報をもとに、原則として 1kgあたりの「中値」を基準に表示しています。

掲載する産地は、取引量が多い主要産地を優先しています。
なお、データ上「中値」が確認できない場合に限り、代替指標として「高値」を表示することがあります。

※相対取引価格は、等級・階級（例：大玉/中玉）、荷姿、出荷ロット等の条件により変動します。`,
        isExpandable: true
      }
    ]
  },
  {
    title: "法人・提携に関するQ＆A",
    items: [
      {
        question: 'Q. 企業・団体との提携やスポンサー相談はできますか？',
        answer: `A. はい、可能です。事業課題に合わせた「成果につながる提携」をご提案します。

NOUVATIONは単なる認知拡大にとどまらず、「貴社アカウントの資産化（フォロワー増）」や「投資意欲の高い現役層への販路開拓」など、ビジネスの目的に直結するパートナーシップを強みとしています。

【NOUVATIONならではの強み】

• 決裁者へのリーチ：フォロワーの96%が現役世代（18〜64歳）。特に35〜54歳の決裁権を持つ層が6割以上を占めており、投資判断ができる経営層へダイレクトに届きます。
• 結果へのコミット：「再生数5万回保証」や広告調整を含めた運用で、確実な到達をお約束します。
• 高い行動喚起力：平均開封率 70%・クリック率 20%超。業界平均を大きく上回る、驚異のアクティブ率の公式LINEなどを活用し、認知を「行動」へ繋げます。

例：ご提案できる連携方法
• 共同企画・共同投稿PRメニュー（Reels /貴社アカウントの資産化）
• ストーリーでのPR（リンク設置可/即時誘導）
• 公式LINEバナー広告（リッチメニュー/常設枠・リッチメッセージ等）
• 農家向けアンケート／ヒアリング協力（市場調査）
• イベント・キャンペーンの告知協力

【進め方】
具体的なプランが決まっていなくても構いません。「新商品を広めたい」「若手農家と繋がりたい」などの目的と、大まかなご予算感をお知らせいただければ、最適な企画をご提案いたします。まずは[お問い合わせフォーム]よりお気軽にご連絡ください。

※現在、長期的なパートナーシップをご希望の企業様向けに、次世代の農業界を共に創る「年間スポンサー」もご相談いただけます。`,
        isExpandable: true
      }
    ]
  }
];
---

<section data-section-theme="light" class="py-24 md:py-32 bg-[#F6F6EE]">
  <div class="max-w-3xl mx-auto px-4 sm:px-6">
    <!-- Section Title -->
    <h2 class="text-3xl md:text-5xl font-bold text-center mb-16 leading-[1.2] text-[#231815] fade-up">
      <span class="font-maru">Q&A</span>
    </h2>

    <!-- FAQ Items -->
    <div class="space-y-12">
      {faqGroups.map((group) => (
        <div class="fade-up">
          {group.title && (
            <h3 class="text-sm font-bold text-[#2e7d32] mb-6 flex items-center">
              <span class="w-1 h-4 bg-[#2e7d32] mr-2"></span>
              {group.title}
            </h3>
          )}
          <div class="space-y-4">
            {group.items.map((item) => (
              <div class="bg-white border border-[#231815]/10 rounded-2xl p-6 md:p-8 hover:shadow-md transition-shadow">
                <h4 class="font-bold text-[#231815] mb-3 text-base md:text-lg">{item.question}</h4>
                
                {item.isExpandable ? (
                  <details class="group">
                    <summary class="list-none cursor-pointer text-[#2e7d32] text-sm font-bold flex items-center group-open:mb-4">
                      <span>回答を見る</span>
                      <svg class="w-4 h-4 ml-1 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                      </svg>
                    </summary>
                    <div class="text-sm md:text-base text-[#231815] leading-loose opacity-80 whitespace-pre-wrap border-t border-[#231815]/5 pt-4">
                      {item.answer}
                      
                      {item.ctaText && (
                        <div class="mt-8">
                          <a 
                            href={item.ctaLink}
                            class="inline-block bg-[#2e7d32] text-white px-8 py-4 rounded-full font-bold text-sm md:text-base hover:-translate-y-0.5 transition-all shadow-md hover:shadow-lg"
                          >
                            {item.ctaText}
                          </a>
                        </div>
                      )}
                    </div>
                  </details>
                ) : (
                  <p class="text-sm md:text-base text-[#231815] leading-loose opacity-80 whitespace-pre-wrap">{item.answer}</p>
                )}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
