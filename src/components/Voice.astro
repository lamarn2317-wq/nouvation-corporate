// Voice - 利用者の声 | Dark Futuristic + Green Glow

const categories = [
  {
    id: 'shisetsu',
    label: '施設野菜',
    items: [
      { age: '30代', quote: '価値の高いメディアだと感じました', text: 'NOUVATIONさまの発信内容、市場情報や制度情報だけでなく現場目線の切り口がとても分かりやすく、農業に関わる方にとって価値の高いメデイアだと感じました。' },
      { age: '30代', quote: '経営の判断材料として活用', text: '施設野菜はコスト管理が重要ですが、NOUVATIONの情報は非常に具体的で、日々の経営判断の大きな助けになっています。' },
      { age: '40代', quote: '若手農家の強い味方', text: '周囲に相談できる相手が少ない中、オンラインでこれだけ質の高い情報に触れられるのは本当にありがたいです。' },
    ]
  },
  {
    id: 'roji',
    label: '露地栽培',
    items: [
      { age: '50代', quote: '非常に参考になる投稿', text: '毎日、天候や市場価格などの情報を丁寧に更新されており、非常に参考になる投稿ばかりで、勉強させていただいております。' },
      { age: '50代', quote: 'ベテランでも新しい発見がある', text: '長年農業をやってきましたが、最新のテクノロジーや市場の動向についてはNOUVATIONから学ぶことが多いです。' },
      { age: '40代', quote: '市場価格の透明性が嬉しい', text: 'これまでは不透明だった市場の動きが、グラフで可視化されることで、納得感のある取引ができるようになりました。' },
    ]
  },
  {
    id: 'shinki',
    label: '新規就農',
    items: [
      { age: '20代', quote: '次世代の最優先事業は農業だと思う', text: '直接農業に携わっているわけではないのですが、祖父母が小さく農業を営んでいて、情報収集の一環としてフォローさせていただきました！個人的にも次世代の最優先事業は農業だと思うのでノーベーションさんには頑張っていただきたいです！！' },
      { age: '20代', quote: '就農前の不安が解消されました', text: '農業を始めるにあたって何から手をつければいいか不安でしたが、NOUVATIONのAIサポートやメディアを通じて、具体的なイメージが持てるようになりました。' },
      { age: '20代', quote: 'SNSでの繋がりが励みに', text: 'Instagramでの発信を見ていると、同じ志を持つ仲間が全国にいると感じられ、モチベーションの維持に繋がっています。' },
    ]
  }
];
---

<section data-section-theme="dark" id="voice" class="voice-section">
  <div class="voice-bg" aria-hidden="true">
    <div class="voice-bg__base"></div>
    <div class="voice-bg__grid"></div>
    <div class="voice-bg__glow voice-bg__glow--1"></div>
    <div class="voice-bg__glow voice-bg__glow--2"></div>
  </div>

  <div class="voice-container">
    <div class="voice-header" data-voice-anim>
      <p class="voice-eyebrow">VOICE</p>
      <h2 class="voice-heading">利用者の声</h2>
    </div>

    <div class="voice-tabs" data-voice-anim>
      {categories.map((cat, i) => (
        <button class={`voice-tab ${i === 0 ? 'is-active' : ''}`} data-tab={cat.id}>{cat.label}</button>
      ))}
    </div>

    <div class="voice-panels">
      {categories.map((cat, ci) => (
        <div class={`voice-panel ${ci === 0 ? 'is-active' : ''}`} data-panel={cat.id}>
          <div class="voice-carousel" data-voice-anim>
            {cat.items.map((item, i) => (
              <article class={`voice-card ${i === 0 ? 'is-current' : ''}`} data-ci={i}>
                <div class="voice-card__inner">
                  <div class="voice-card__top">
                    <span class="voice-card__age">{item.age}</span>
                    <span class="voice-card__deco">"</span>
                  </div>
                  <h3 class="voice-card__quote">「{item.quote}」</h3>
                  <p class="voice-card__body">{item.text}</p>
                </div>
              </article>
            ))}
          </div>
          <div class="voice-indicators" data-voice-anim>
            {cat.items.map((_, i) => (
              <button class={`voice-indicator ${i === 0 ? 'is-active' : ''}`} data-goto={i} aria-label={`${i + 1}番目`}></button>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .voice-section {
    position: relative;
    padding: 7rem 0 8rem;
    overflow: hidden;
    isolation: isolate;
    background: #080f0b;
  }

  /* ===== Background ===== */
  .voice-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .voice-bg__base {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 100% 80% at 50% 20%, rgba(30, 90, 50, 0.15), transparent 60%),
                radial-gradient(ellipse 80% 60% at 70% 80%, rgba(20, 80, 45, 0.1), transparent 50%);
  }

  .voice-bg__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(40, 160, 80, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(40, 160, 80, 0.04) 1px, transparent 1px);
    background-size: 70px 70px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, black 0%, transparent 70%);
  }

  .voice-bg__glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    animation: glowPulse 15s ease-in-out infinite;
  }

  .voice-bg__glow--1 {
    width: 500px;
    height: 500px;
    background: rgba(30, 120, 60, 0.15);
    top: -10%;
    left: 5%;
  }

  .voice-bg__glow--2 {
    width: 400px;
    height: 400px;
    background: rgba(20, 100, 50, 0.1);
    bottom: -5%;
    right: 5%;
    animation-delay: -7s;
  }

  @keyframes glowPulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.15); opacity: 0.7; }
  }

  /* ===== Container ===== */
  .voice-container {
    position: relative;
    z-index: 1;
    max-width: 960px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* ===== Header ===== */
  .voice-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .voice-eyebrow {
    font-size: clamp(2.2rem, 6vw, 3.5rem);
    font-weight: 700;
    letter-spacing: 0.15em;
    color: #fff;
    line-height: 1.1;
    text-shadow: 0 0 40px rgba(40, 180, 80, 0.2);
  }

  .voice-heading {
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    color: rgba(255, 255, 255, 0.5);
    margin-top: 0.6rem;
  }

  /* ===== Tabs ===== */
  .voice-tabs {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 3rem;
    flex-wrap: wrap;
  }

  .voice-tab {
    padding: 0.55rem 1.6rem;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 100px;
    cursor: pointer;
    transition: all 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    backdrop-filter: blur(8px);
  }

  .voice-tab:hover {
    color: rgba(255, 255, 255, 0.8);
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(40, 160, 80, 0.2);
  }

  .voice-tab.is-active {
    color: #fff;
    background: rgba(40, 160, 80, 0.2);
    border-color: rgba(40, 160, 80, 0.4);
    box-shadow: 0 0 20px rgba(40, 160, 80, 0.1), inset 0 1px 0 rgba(255,255,255,0.05);
  }

  /* ===== Panels ===== */
  .voice-panels {
    position: relative;
    min-height: 480px;
  }

  .voice-panel { display: none; }
  .voice-panel.is-active {
    display: block;
    animation: panelIn 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes panelIn {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ===== Carousel ===== */
  .voice-carousel {
    position: relative;
    height: 440px;
    perspective: 1200px;
  }

  /* ===== Card ===== */
  .voice-card {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 75%;
    max-width: 360px;
    transform: translate(-50%, -50%) scale(0.7);
    opacity: 0;
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, opacity;
    pointer-events: none;
  }

  /* ACTIVE — 大きく前に出る */
  .voice-card.is-current {
    transform: translate(-50%, -50%) scale(1);
    opacity: 1;
    z-index: 3;
    pointer-events: auto;
    animation: cardFloat 5s ease-in-out infinite;
  }

  /* 右に小さく */
  .voice-card.is-next {
    transform: translate(-10%, -50%) scale(0.72) rotateY(-12deg);
    opacity: 0.3;
    z-index: 2;
    filter: blur(2px);
  }

  /* 左に小さく */
  .voice-card.is-prev {
    transform: translate(-90%, -50%) scale(0.72) rotateY(12deg);
    opacity: 0.3;
    z-index: 2;
    filter: blur(2px);
  }

  .voice-card.is-hidden {
    transform: translate(-50%, -50%) scale(0.6);
    opacity: 0;
    z-index: 0;
  }

  @keyframes cardFloat {
    0%, 100% { transform: translate(-50%, -50%) scale(1) translateY(0); }
    50% { transform: translate(-50%, -50%) scale(1) translateY(-6px); }
  }

  /* ===== Card Inner — Glass Dark ===== */
  .voice-card__inner {
    background: linear-gradient(160deg, rgba(255,255,255,0.08), rgba(255,255,255,0.03));
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-radius: 1.1rem;
    padding: 2.2rem 2rem 2rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow:
      0 20px 60px rgba(0, 0, 0, 0.4),
      0 0 40px rgba(30, 120, 60, 0.05),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    transition: box-shadow 0.3s ease, transform 0.15s ease-out;
    min-height: 320px;
    display: flex;
    flex-direction: column;
  }

  .voice-card.is-current .voice-card__inner {
    border-color: rgba(40, 160, 80, 0.15);
    box-shadow:
      0 24px 70px rgba(0, 0, 0, 0.5),
      0 0 60px rgba(30, 120, 60, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .voice-card.is-current .voice-card__inner:hover {
    border-color: rgba(40, 160, 80, 0.25);
    box-shadow:
      0 28px 80px rgba(0, 0, 0, 0.5),
      0 0 80px rgba(30, 120, 60, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  /* Card content */
  .voice-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.2rem;
  }

  .voice-card__age {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: rgba(80, 220, 120, 0.9);
    padding: 0.2rem 0.7rem;
    background: rgba(40, 160, 80, 0.1);
    border: 1px solid rgba(40, 160, 80, 0.2);
    border-radius: 100px;
  }

  .voice-card__deco {
    font-size: 3.5rem;
    font-weight: 700;
    line-height: 1;
    color: rgba(40, 160, 80, 0.15);
    font-family: Georgia, serif;
    user-select: none;
  }

  .voice-card__quote {
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.95);
    margin-bottom: 1rem;
  }

  .voice-card__body {
    font-size: 0.8rem;
    line-height: 1.95;
    color: rgba(255, 255, 255, 0.45);
    margin-top: auto;
  }

  /* ===== Indicators ===== */
  .voice-indicators {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 1.5rem;
  }

  .voice-indicator {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    border: none;
    padding: 0;
    background: rgba(255, 255, 255, 0.15);
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .voice-indicator.is-active {
    width: 26px;
    border-radius: 100px;
    background: linear-gradient(90deg, rgba(40, 160, 80, 0.8), rgba(80, 220, 120, 0.6));
    box-shadow: 0 0 12px rgba(40, 160, 80, 0.4);
  }

  /* ===== Scroll Reveal ===== */
  [data-voice-anim] {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
                transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  [data-voice-anim].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ===== Responsive ===== */
  @media (max-width: 640px) {
    .voice-section { padding: 4.5rem 0 5rem; }
    .voice-carousel { height: 420px; }
    .voice-card { width: 88%; }
    .voice-card__inner { padding: 1.8rem 1.5rem 1.5rem; min-height: 300px; }
    .voice-card__quote { font-size: 1rem; }
    .voice-bg__glow--1 { width: 300px; height: 300px; }
    .voice-bg__glow--2 { width: 250px; height: 250px; }
  }
</style>

<script>
  function initVoice() {
    const tabs = document.querySelectorAll('.voice-tab') as NodeListOf<HTMLElement>;
    const panels = document.querySelectorAll('.voice-panel') as NodeListOf<HTMLElement>;

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const id = tab.dataset.tab;
        tabs.forEach(t => t.classList.remove('is-active'));
        tab.classList.add('is-active');
        panels.forEach(p => {
          p.classList.remove('is-active');
          if (p.dataset.panel === id) { p.classList.add('is-active'); initCarousel(p); }
        });
      });
    });

    panels.forEach(p => { if (p.classList.contains('is-active')) initCarousel(p); });

    function initCarousel(panel: HTMLElement) {
      const cards = panel.querySelectorAll('.voice-card') as NodeListOf<HTMLElement>;
      const dots = panel.querySelectorAll('.voice-indicator') as NodeListOf<HTMLElement>;
      const total = cards.length;
      let current = 0;
      let timer: ReturnType<typeof setInterval> | null = null;
      if ((panel as any)._vt) clearInterval((panel as any)._vt);

      function update() {
        cards.forEach((card, i) => {
          card.classList.remove('is-current', 'is-next', 'is-prev', 'is-hidden');
          if (i === current) card.classList.add('is-current');
          else if (i === (current + 1) % total) card.classList.add('is-next');
          else if (i === (current - 1 + total) % total) card.classList.add('is-prev');
          else card.classList.add('is-hidden');
        });
        dots.forEach((d, i) => d.classList.toggle('is-active', i === current));
      }

      function next() { current = (current + 1) % total; update(); }
      function startAuto() { stopAuto(); timer = setInterval(next, 4500); (panel as any)._vt = timer; }
      function stopAuto() { if (timer) { clearInterval(timer); timer = null; } }

      dots.forEach((d, i) => d.addEventListener('click', () => { current = i; update(); startAuto(); }));

      // Swipe
      let sx = 0, dragging = false, dx = 0;
      const car = panel.querySelector('.voice-carousel') as HTMLElement;

      car?.addEventListener('touchstart', (e) => {
        sx = (e as TouchEvent).touches[0].clientX; dragging = true; dx = 0; stopAuto();
        const ac = car.querySelector('.is-current') as HTMLElement;
        if (ac) ac.style.transition = 'none';
      }, { passive: true });

      car?.addEventListener('touchmove', (e) => {
        if (!dragging) return;
        dx = (e as TouchEvent).touches[0].clientX - sx;
        const ac = car.querySelector('.is-current') as HTMLElement;
        if (ac) {
          const r = dx * -0.015;
          ac.style.transform = `translate(calc(-50% + ${dx}px), -50%) scale(1) rotateY(${r}deg)`;
        }
      }, { passive: true });

      car?.addEventListener('touchend', () => {
        dragging = false;
        const ac = car.querySelector('.is-current') as HTMLElement;
        if (ac) ac.style.transition = '';
        if (Math.abs(dx) > 50) {
          if (dx < 0) current = (current + 1) % total;
          else current = (current - 1 + total) % total;
        }
        update(); startAuto();
      }, { passive: true });

      // Mouse tilt
      car?.addEventListener('mousemove', (e) => {
        const ac = car.querySelector('.is-current .voice-card__inner') as HTMLElement;
        if (!ac) return;
        const rect = ac.getBoundingClientRect();
        const x = ((e as MouseEvent).clientX - rect.left) / rect.width;
        const y = ((e as MouseEvent).clientY - rect.top) / rect.height;
        ac.style.transform = `perspective(800px) rotateX(${(y-0.5)*-5}deg) rotateY(${(x-0.5)*5}deg)`;
      });
      car?.addEventListener('mouseleave', () => {
        const ac = car.querySelector('.is-current .voice-card__inner') as HTMLElement;
        if (ac) ac.style.transform = '';
      });

      car?.addEventListener('mouseenter', stopAuto);
      car?.addEventListener('mouseleave', startAuto);

      update(); startAuto();
    }

    const obs = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('is-visible'); });
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('[data-voice-anim]').forEach(el => obs.observe(el));
  }

  document.addEventListener('astro:page-load', initVoice);
  initVoice();
</script>
