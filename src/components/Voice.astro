// Voice - 利用者の声 | Green Gradient + Portrait Card

const categories = [
  {
    id: 'shisetsu',
    label: '施設野菜',
    items: [
      { age: '30代', quote: '価値の高いメディアだと感じました', text: 'NOUVATIONさまの発信内容、市場情報や制度情報だけでなく現場目線の切り口がとても分かりやすく、農業に関わる方にとって価値の高いメデイアだと感じました。' },
      { age: '30代', quote: '経営の判断材料として活用', text: '施設野菜はコスト管理が重要ですが、NOUVATIONの情報は非常に具体的で、日々の経営判断の大きな助けになっています。' },
      { age: '40代', quote: '若手農家の強い味方', text: '周囲に相談できる相手が少ない中、オンラインでこれだけ質の高い情報に触れられるのは本当にありがたいです。' },
    ]
  },
  {
    id: 'roji',
    label: '露地栽培',
    items: [
      { age: '50代', quote: '非常に参考になる投稿', text: '毎日、天候や市場価格などの情報を丁寧に更新されており、非常に参考になる投稿ばかりで、勉強させていただいております。' },
      { age: '50代', quote: 'ベテランでも新しい発見がある', text: '長年農業をやってきましたが、最新のテクノロジーや市場の動向についてはNOUVATIONから学ぶことが多いです。' },
      { age: '40代', quote: '市場価格の透明性が嬉しい', text: 'これまでは不透明だった市場の動きが、グラフで可視化されることで、納得感のある取引ができるようになりました。' },
    ]
  },
  {
    id: 'shinki',
    label: '新規就農',
    items: [
      { age: '20代', quote: '次世代の最優先事業は農業だと思う', text: '直接農業に携わっているわけではないのですが、祖父母が小さく農業を営んでいて、情報収集の一環としてフォローさせていただきました！個人的にも次世代の最優先事業は農業だと思うのでノーベーションさんには頑張っていただきたいです！！' },
      { age: '20代', quote: '就農前の不安が解消されました', text: '農業を始めるにあたって何から手をつければいいか不安でしたが、NOUVATIONのAIサポートやメディアを通じて、具体的なイメージが持てるようになりました。' },
      { age: '20代', quote: 'SNSでの繋がりが励みに', text: 'Instagramでの発信を見ていると、同じ志を持つ仲間が全国にいると感じられ、モチベーションの維持に繋がっています。' },
    ]
  }
];
---

<section data-section-theme="light" id="voice" class="voice-section">
  <div class="voice-container">
    <div class="voice-header" data-voice-anim>
      <p class="voice-eyebrow">VOICE</p>
      <h2 class="voice-heading">利用者の声</h2>
    </div>

    <div class="voice-tabs" data-voice-anim>
      {categories.map((cat, i) => (
        <button class={`voice-tab ${i === 0 ? 'is-active' : ''}`} data-tab={cat.id}>{cat.label}</button>
      ))}
    </div>

    <div class="voice-panels">
      {categories.map((cat, ci) => (
        <div class={`voice-panel ${ci === 0 ? 'is-active' : ''}`} data-panel={cat.id}>
          <div class="voice-carousel" data-voice-anim>
            {cat.items.map((item, i) => (
              <article class={`voice-card ${i === 0 ? 'is-current' : ''}`} data-ci={i}>
                <div class="voice-card__inner">
                  <div class="voice-card__top">
                    <span class="voice-card__age">{item.age}</span>
                    <span class="voice-card__deco">"</span>
                  </div>
                  <h3 class="voice-card__quote">「{item.quote}」</h3>
                  <p class="voice-card__body">{item.text}</p>
                  <div class="voice-card__footer">
                    <span class="voice-card__tag">NOUVATION</span>
                  </div>
                </div>
              </article>
            ))}
          </div>
          <div class="voice-indicators" data-voice-anim>
            {cat.items.map((_, i) => (
              <button class={`voice-indicator ${i === 0 ? 'is-active' : ''}`} data-goto={i} aria-label={`${i + 1}番目`}></button>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .voice-section {
    position: relative;
    padding: 7rem 0 8rem;
    overflow: hidden;
    background: linear-gradient(145deg,
      #1b5e3a 0%,
      #267a4a 20%,
      #2f8f55 40%,
      #3da564 60%,
      #4fba72 78%,
      #6dce88 90%,
      #8ddfa0 100%
    );
  }

  /* ===== Container ===== */
  .voice-container {
    position: relative;
    z-index: 1;
    max-width: 960px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* ===== Header ===== */
  .voice-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .voice-eyebrow {
    font-size: clamp(2.2rem, 6vw, 3.5rem);
    font-weight: 700;
    letter-spacing: 0.15em;
    color: #fff;
    line-height: 1.1;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.2);
  }

  .voice-heading {
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    color: rgba(255, 255, 255, 0.75);
    margin-top: 0.6rem;
  }

  /* ===== Tabs ===== */
  .voice-tabs {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 3rem;
    flex-wrap: wrap;
  }

  .voice-tab {
    padding: 0.55rem 1.6rem;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.75);
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 100px;
    cursor: pointer;
    transition: all 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    backdrop-filter: blur(8px);
  }

  .voice-tab:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.25);
    border-color: rgba(255, 255, 255, 0.5);
  }

  .voice-tab.is-active {
    color: #1b5e3a;
    background: rgba(255, 255, 255, 0.95);
    border-color: rgba(255, 255, 255, 1);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
  }

  /* ===== Panels ===== */
  .voice-panels {
    position: relative;
    min-height: 540px;
  }

  .voice-panel { display: none; }
  .voice-panel.is-active {
    display: block;
    animation: panelIn 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes panelIn {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ===== Carousel ===== */
  .voice-carousel {
    position: relative;
    height: 480px;
    perspective: 1400px;
    overflow: visible;
    touch-action: pan-y;
    user-select: none;
  }

  /* ===== Card — ハガキ縦型 ===== */
  .voice-card {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 220px;
    /* portrait ratio: ~A5/postcard ~1:1.5 */
    transform-origin: center center;
    transform: translate(-50%, -50%) scale(0.72) rotateY(0deg);
    opacity: 0;
    transition: transform 0.55s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.55s cubic-bezier(0.16, 1, 0.3, 1),
                filter 0.55s ease;
    will-change: transform, opacity;
    pointer-events: none;
  }

  /* ACTIVE */
  .voice-card.is-current {
    transform: translate(-50%, -50%) scale(1) rotateY(0deg);
    opacity: 1;
    z-index: 3;
    pointer-events: auto;
    filter: none;
    animation: cardFloat 5s ease-in-out infinite;
  }

  /* 右に小さく */
  .voice-card.is-next {
    transform: translate(20%, -50%) scale(0.72) rotateY(-15deg);
    opacity: 0.55;
    z-index: 2;
    filter: blur(1px);
    pointer-events: auto;
  }

  /* 左に小さく */
  .voice-card.is-prev {
    transform: translate(-120%, -50%) scale(0.72) rotateY(15deg);
    opacity: 0.55;
    z-index: 2;
    filter: blur(1px);
    pointer-events: auto;
  }

  .voice-card.is-hidden {
    transform: translate(-50%, -50%) scale(0.5);
    opacity: 0;
    z-index: 0;
    pointer-events: none;
  }

  @keyframes cardFloat {
    0%, 100% { transform: translate(-50%, -50%) scale(1) translateY(0); }
    50% { transform: translate(-50%, -50%) scale(1) translateY(-8px); }
  }

  /* drag中はfloat止める */
  .voice-card.is-dragging {
    animation: none !important;
  }

  /* ===== Card Inner — 白ハガキ ===== */
  .voice-card__inner {
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: 1rem;
    padding: 2rem 1.6rem 1.6rem;
    border: 1px solid rgba(255, 255, 255, 0.8);
    box-shadow:
      0 20px 60px rgba(0, 0, 0, 0.2),
      0 4px 16px rgba(0, 0, 0, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 1);
    transition: box-shadow 0.3s ease;
    min-height: 340px;
    display: flex;
    flex-direction: column;
  }

  .voice-card.is-current .voice-card__inner {
    box-shadow:
      0 30px 80px rgba(0, 0, 0, 0.25),
      0 8px 30px rgba(27, 94, 58, 0.15),
      inset 0 1px 0 rgba(255, 255, 255, 1);
  }

  /* Card content */
  .voice-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.2rem;
  }

  .voice-card__age {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #fff;
    padding: 0.25rem 0.75rem;
    background: #2f8f55;
    border-radius: 100px;
  }

  .voice-card__deco {
    font-size: 3.5rem;
    font-weight: 700;
    line-height: 1;
    color: rgba(47, 143, 85, 0.2);
    font-family: Georgia, serif;
    user-select: none;
  }

  .voice-card__quote {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.7;
    color: #1b5e3a;
    margin-bottom: 1rem;
  }

  .voice-card__body {
    font-size: 0.75rem;
    line-height: 1.9;
    color: #3a5a45;
    flex: 1;
  }

  .voice-card__footer {
    margin-top: 1.2rem;
    border-top: 1px solid rgba(47, 143, 85, 0.15);
    padding-top: 0.8rem;
  }

  .voice-card__tag {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: rgba(47, 143, 85, 0.5);
  }

  /* ===== Indicators ===== */
  .voice-indicators {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 1.5rem;
  }

  .voice-indicator {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    border: none;
    padding: 0;
    background: rgba(255, 255, 255, 0.4);
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .voice-indicator.is-active {
    width: 26px;
    border-radius: 100px;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 0 12px rgba(255, 255, 255, 0.4);
  }

  /* ===== Scroll Reveal ===== */
  [data-voice-anim] {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
                transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  [data-voice-anim].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ===== Responsive ===== */
  @media (max-width: 640px) {
    .voice-section { padding: 4.5rem 0 5rem; }
    .voice-carousel { height: 460px; }
    .voice-card { width: 190px; }
    .voice-card__inner { padding: 1.6rem 1.3rem 1.3rem; min-height: 300px; }
    .voice-card__quote { font-size: 0.9rem; }
  }
</style>

<script>
  function initVoice() {
    const tabs = document.querySelectorAll('.voice-tab') as NodeListOf<HTMLElement>;
    const panels = document.querySelectorAll('.voice-panel') as NodeListOf<HTMLElement>;

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const id = tab.dataset.tab;
        tabs.forEach(t => t.classList.remove('is-active'));
        tab.classList.add('is-active');
        panels.forEach(p => {
          p.classList.remove('is-active');
          if (p.dataset.panel === id) {
            p.classList.add('is-active');
            initCarousel(p);
          }
        });
      });
    });

    panels.forEach(p => { if (p.classList.contains('is-active')) initCarousel(p); });

    function initCarousel(panel: HTMLElement) {
      const cards = panel.querySelectorAll('.voice-card') as NodeListOf<HTMLElement>;
      const dots = panel.querySelectorAll('.voice-indicator') as NodeListOf<HTMLElement>;
      const total = cards.length;
      let current = 0;
      let isDragging = false;
      let startX = 0;
      let currentDX = 0;

      function update(animate = true) {
        cards.forEach((card, i) => {
          card.classList.remove('is-current', 'is-next', 'is-prev', 'is-hidden');
          if (!animate) card.style.transition = 'none';
          else card.style.transition = '';

          if (i === current) card.classList.add('is-current');
          else if (i === (current + 1) % total) card.classList.add('is-next');
          else if (i === (current - 1 + total) % total) card.classList.add('is-prev');
          else card.classList.add('is-hidden');
        });
        dots.forEach((d, i) => d.classList.toggle('is-active', i === current));

        // reflow trick to apply no-transition immediately
        if (!animate) {
          cards.forEach(c => c.getBoundingClientRect());
          cards.forEach(c => c.style.transition = '');
        }
      }

      dots.forEach((d, i) => d.addEventListener('click', () => { current = i; update(); }));

      // prev/next card click
      cards.forEach((card) => {
        card.addEventListener('click', () => {
          if (Math.abs(currentDX) > 5) return; // ignore drag end
          if (card.classList.contains('is-next')) { current = (current + 1) % total; update(); }
          else if (card.classList.contains('is-prev')) { current = (current - 1 + total) % total; update(); }
        });
      });

      // ===== Smooth Swipe =====
      const car = panel.querySelector('.voice-carousel') as HTMLElement;

      function onDragStart(x: number) {
        isDragging = true;
        startX = x;
        currentDX = 0;
        const ac = car.querySelector('.is-current') as HTMLElement;
        if (ac) {
          ac.classList.add('is-dragging');
          ac.style.transition = 'none';
        }
      }

      function onDragMove(x: number) {
        if (!isDragging) return;
        currentDX = x - startX;
        const ac = car.querySelector('.is-current') as HTMLElement;
        if (!ac) return;
        const rot = currentDX * -0.02;
        const scale = 1 - Math.abs(currentDX) * 0.0003;
        ac.style.transform = `translate(calc(-50% + ${currentDX}px), -50%) scale(${Math.max(scale, 0.9)}) rotateY(${rot}deg)`;
      }

      function onDragEnd() {
        if (!isDragging) return;
        isDragging = false;
        const ac = car.querySelector('.is-current') as HTMLElement;
        if (ac) {
          ac.classList.remove('is-dragging');
          ac.style.transition = '';
          ac.style.transform = '';
        }
        if (Math.abs(currentDX) > 60) {
          if (currentDX < 0) current = (current + 1) % total;
          else current = (current - 1 + total) % total;
        }
        update();
        currentDX = 0;
      }

      // Touch
      car?.addEventListener('touchstart', (e) => {
        onDragStart((e as TouchEvent).touches[0].clientX);
      }, { passive: true });

      car?.addEventListener('touchmove', (e) => {
        onDragMove((e as TouchEvent).touches[0].clientX);
      }, { passive: true });

      car?.addEventListener('touchend', onDragEnd, { passive: true });

      // Mouse
      car?.addEventListener('mousedown', (e) => {
        onDragStart((e as MouseEvent).clientX);
        e.preventDefault();
      });

      window.addEventListener('mousemove', (e) => {
        if (isDragging) onDragMove((e as MouseEvent).clientX);
      });

      window.addEventListener('mouseup', () => {
        if (isDragging) onDragEnd();
      });

      update();
    }

    // Scroll reveal
    const obs = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('is-visible'); });
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('[data-voice-anim]').forEach(el => obs.observe(el));
  }

  document.addEventListener('astro:page-load', initVoice);
  initVoice();
</script>
