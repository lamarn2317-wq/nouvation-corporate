---

<section id="voice" class="voice-section">
  <!-- Gradient Background -->
  <div class="voice-bg" aria-hidden="true">
    <div class="voice-bg__gradient"></div>
    <div class="voice-bg__noise"></div>
    <!-- Floating circles -->
    <!-- circles removed -->
  </div>

  <div class="voice-container">
    <!-- Header -->
    <div class="voice-header" data-voice-anim>
      <p class="voice-eyebrow">VOICE</p>
      <h2 class="voice-heading">利用者の声</h2>
    </div>

    <!-- Category Tabs -->
    <div class="voice-tabs" data-voice-anim>
      {categories.map((cat, i) => (
        <button
          class={`voice-tab ${i === 0 ? 'is-active' : ''}`}
          data-tab={cat.id}
        >
          {cat.label}
        </button>
      ))}
    </div>

    <!-- Card Panels -->
    <div class="voice-panels">
      {categories.map((cat, ci) => (
        <div
          class={`voice-panel ${ci === 0 ? 'is-active' : ''}`}
          data-panel={cat.id}
        >
          <div class="voice-carousel" data-voice-anim>
            {cat.items.map((item, i) => (
              <article
                class={`voice-card ${i === 0 ? 'is-current' : ''}`}
                data-ci={i}
              >
                <div class="voice-card__inner">
                  <div class="voice-card__top">
                    <span class="voice-card__age">{item.age}</span>
                    <span class="voice-card__deco">"</span>
                  </div>
                  <h3 class="voice-card__quote">「{item.quote}」</h3>
                  <p class="voice-card__body">{item.text}</p>
                </div>
              </article>
            ))}
          </div>

          <!-- Dots -->
          <div class="voice-indicators" data-voice-anim>
            {cat.items.map((_, i) => (
              <button
                class={`voice-indicator ${i === 0 ? 'is-active' : ''}`}
                data-goto={i}
                aria-label={`${i + 1}番目`}
              ></button>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* ===== Section ===== */
  .voice-section {
    position: relative;
    padding: 6rem 0 7rem;
    overflow: hidden;
    isolation: isolate;
  }

  /* ===== Gradient Background ===== */
  .voice-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .voice-bg__gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      #1b5e3a 0%,
      #267a4a 15%,
      #2f8f55 30%,
      #3da564 50%,
      #4fba72 70%,
      #6dce88 85%,
      #8ddfa0 100%
    );
  }

  .voice-bg__noise {
    position: absolute;
    inset: 0;
    opacity: 0.3;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.05'/%3E%3C/svg%3E");
    mix-blend-mode: overlay;
  }

  /* circles removed */

  /* ===== Container ===== */
  .voice-container {
    position: relative;
    z-index: 1;
    max-width: 960px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* ===== Header ===== */
  .voice-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .voice-eyebrow {
    font-size: clamp(2.2rem, 6vw, 3.5rem);
    font-weight: 700;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.95);
    line-height: 1.1;
  }

  .voice-heading {
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    color: rgba(255, 255, 255, 0.7);
    margin-top: 0.6rem;
  }

  /* ===== Tabs ===== */
  .voice-tabs {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 3rem;
    flex-wrap: wrap;
  }

  .voice-tab {
    position: relative;
    padding: 0.6rem 1.8rem;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.7);
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 100px;
    cursor: pointer;
    transition: all 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .voice-tab:hover {
    background: rgba(255, 255, 255, 0.18);
    color: #fff;
  }

  .voice-tab.is-active {
    background: rgba(255, 255, 255, 0.95);
    color: #1b5e3a;
    border-color: transparent;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  }

  /* ===== Panels ===== */
  .voice-panels {
    position: relative;
    min-height: 360px;
  }

  .voice-panel {
    display: none;
  }

  .voice-panel.is-active {
    display: block;
    animation: panelIn 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes panelIn {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ===== Carousel ===== */
  .voice-carousel {
    position: relative;
    height: 440px;
    perspective: 1200px;
  }

  /* ===== Card ===== */
  .voice-card {
    position: absolute;
    top: 0;
    left: 50%;
    width: 88%;
    max-width: 440px;
    transform: translateX(-50%);
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, opacity;
  }

  /* States */
  .voice-card.is-current {
    transform: translateX(-50%) translateY(0) scale(1) rotateY(0);
    opacity: 1;
    z-index: 3;
    animation: cardFloat 5s ease-in-out infinite;
  }

  .voice-card.is-next {
    transform: translateX(-20%) translateY(20px) scale(0.88) rotateY(-8deg);
    opacity: 0.35;
    z-index: 2;
    pointer-events: none;
    filter: blur(2px);
  }

  .voice-card.is-prev {
    transform: translateX(-80%) translateY(20px) scale(0.88) rotateY(8deg);
    opacity: 0.35;
    z-index: 2;
    pointer-events: none;
    filter: blur(2px);
  }

  .voice-card.is-hidden {
    transform: translateX(-50%) translateY(40px) scale(0.8);
    opacity: 0;
    z-index: 0;
    pointer-events: none;
  }

  /* Floating animation */
  @keyframes cardFloat {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(-8px); }
  }

  /* Card inner */
  .voice-card__inner {
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: 1.2rem;
    padding: 2rem 2rem 1.8rem;
    border: 1px solid rgba(255, 255, 255, 0.6);
    box-shadow:
      0 20px 60px rgba(0, 60, 40, 0.12),
      0 8px 24px rgba(0, 60, 40, 0.08),
      0 0 0 1px rgba(255, 255, 255, 0.3) inset;
    transition: box-shadow 0.3s ease, transform 0.15s ease-out;
  }

  .voice-card.is-current .voice-card__inner:hover {
    box-shadow:
      0 24px 70px rgba(0, 60, 40, 0.16),
      0 10px 30px rgba(0, 60, 40, 0.1),
      0 0 0 1px rgba(255, 255, 255, 0.4) inset;
  }

  .voice-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .voice-card__age {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: #1b5e3a;
    padding: 0.2rem 0.7rem;
    background: rgba(26, 107, 90, 0.08);
    border: 1px solid rgba(26, 107, 90, 0.15);
    border-radius: 100px;
  }

  .voice-card__deco {
    font-size: 3rem;
    font-weight: 700;
    line-height: 1;
    color: rgba(26, 107, 90, 0.12);
    font-family: Georgia, serif;
    user-select: none;
  }

  .voice-card__quote {
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.7;
    color: #1a3a30;
    margin-bottom: 0.8rem;
  }

  .voice-card__body {
    font-size: 0.82rem;
    line-height: 1.9;
    color: rgba(26, 58, 48, 0.6);
  }

  /* ===== Indicators ===== */
  .voice-indicators {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 1.5rem;
  }

  .voice-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: none;
    padding: 0;
    background: rgba(255, 255, 255, 0.35);
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .voice-indicator.is-active {
    width: 28px;
    border-radius: 100px;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  /* ===== Scroll Reveal ===== */
  [data-voice-anim] {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
                transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  [data-voice-anim].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ===== Responsive ===== */
  @media (max-width: 640px) {
    .voice-section {
      padding: 4rem 0 5rem;
    }

    .voice-carousel {
      height: 420px;
    }

    .voice-card {
      width: 92%;
    }

    .voice-card__inner {
      padding: 1.5rem 1.3rem 1.3rem;
    }

    .voice-card__quote {
      font-size: 1rem;
    }

    .voice-bg__circle--1 {
      width: 300px;
      height: 300px;
    }

    .voice-bg__circle--2 {
      width: 200px;
      height: 200px;
    }

    .voice-bg__circle--3 {
      display: none;
    }
  }
</style>

<script>
  function initVoice() {
    // Tab switching
    const tabs = document.querySelectorAll('.voice-tab') as NodeListOf<HTMLElement>;
    const panels = document.querySelectorAll('.voice-panel') as NodeListOf<HTMLElement>;

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const id = tab.dataset.tab;
        tabs.forEach(t => t.classList.remove('is-active'));
        tab.classList.add('is-active');

        panels.forEach(p => {
          p.classList.remove('is-active');
          if (p.dataset.panel === id) {
            p.classList.add('is-active');
            // Reset carousel to first card
            initCarousel(p);
          }
        });
      });
    });

    // Init carousels
    panels.forEach(p => {
      if (p.classList.contains('is-active')) initCarousel(p);
    });

    function initCarousel(panel: HTMLElement) {
      const cards = panel.querySelectorAll('.voice-card') as NodeListOf<HTMLElement>;
      const dots = panel.querySelectorAll('.voice-indicator') as NodeListOf<HTMLElement>;
      const total = cards.length;
      let current = 0;
      let timer: ReturnType<typeof setInterval> | null = null;

      // Clear any existing timer stored on panel
      if ((panel as any)._voiceTimer) {
        clearInterval((panel as any)._voiceTimer);
      }

      function update() {
        cards.forEach((card, i) => {
          card.classList.remove('is-current', 'is-next', 'is-prev', 'is-hidden');
          if (i === current) {
            card.classList.add('is-current');
          } else if (i === (current + 1) % total) {
            card.classList.add('is-next');
          } else if (i === (current - 1 + total) % total) {
            card.classList.add('is-prev');
          } else {
            card.classList.add('is-hidden');
          }
        });

        dots.forEach((dot, i) => {
          dot.classList.toggle('is-active', i === current);
        });
      }

      function next() {
        current = (current + 1) % total;
        update();
      }

      function startAuto() {
        stopAuto();
        timer = setInterval(next, 4500);
        (panel as any)._voiceTimer = timer;
      }

      function stopAuto() {
        if (timer) { clearInterval(timer); timer = null; }
      }

      // Dot click
      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          current = i;
          update();
          startAuto();
        });
      });

      // Swipe with drag tracking
      let startX = 0;
      let isDragging = false;
      let dragDelta = 0;
      const carousel = panel.querySelector('.voice-carousel') as HTMLElement;

      carousel?.addEventListener('touchstart', (e) => {
        startX = (e as TouchEvent).touches[0].clientX;
        isDragging = true;
        dragDelta = 0;
        stopAuto();
        // Disable transition during drag
        const activeCard = carousel.querySelector('.is-current') as HTMLElement;
        if (activeCard) activeCard.style.transition = 'none';
      }, { passive: true });

      carousel?.addEventListener('touchmove', (e) => {
        if (!isDragging) return;
        dragDelta = (e as TouchEvent).touches[0].clientX - startX;
        const activeCard = carousel.querySelector('.is-current') as HTMLElement;
        if (activeCard) {
          const rotate = dragDelta * -0.02;
          activeCard.style.transform = `translateX(calc(-50% + ${dragDelta}px)) translateY(0) scale(1) rotateY(${rotate}deg)`;
          activeCard.style.opacity = `${1 - Math.abs(dragDelta) * 0.002}`;
        }
      }, { passive: true });

      carousel?.addEventListener('touchend', () => {
        isDragging = false;
        const activeCard = carousel.querySelector('.is-current') as HTMLElement;
        if (activeCard) {
          activeCard.style.transition = '';
          activeCard.style.opacity = '';
        }
        if (Math.abs(dragDelta) > 50) {
          if (dragDelta < 0) { current = (current + 1) % total; }
          else { current = (current - 1 + total) % total; }
        }
        update();
        startAuto();
      }, { passive: true });

      // Mouse tilt on active card
      carousel?.addEventListener('mousemove', (e) => {
        const active = carousel.querySelector('.is-current .voice-card__inner') as HTMLElement;
        if (!active) return;
        const rect = active.getBoundingClientRect();
        const x = ((e as MouseEvent).clientX - rect.left) / rect.width;
        const y = ((e as MouseEvent).clientY - rect.top) / rect.height;
        const rx = (y - 0.5) * -4;
        const ry = (x - 0.5) * 4;
        active.style.transform = `perspective(800px) rotateX(${rx}deg) rotateY(${ry}deg)`;
      });

      carousel?.addEventListener('mouseleave', () => {
        const active = carousel.querySelector('.is-current .voice-card__inner') as HTMLElement;
        if (active) active.style.transform = '';
      });

      // Pause on hover
      carousel?.addEventListener('mouseenter', stopAuto);
      carousel?.addEventListener('mouseleave', startAuto);

      update();
      startAuto();
    }

    // Scroll reveal
    const obs = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) e.target.classList.add('is-visible');
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

    document.querySelectorAll('[data-voice-anim]').forEach(el => obs.observe(el));
  }

  document.addEventListener('astro:page-load', initVoice);
  initVoice();
</script>
