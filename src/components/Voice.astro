---
// Voice (User Testimonials) Component - 3D Carousel

const voiceGroups = [
  {
    id: 'shisetsu',
    category: '(仮)30代・施設野菜',
    items: [
      {
        title: '「価値の高いメディアだと感じました」',
        text: 'NOUVATIONさまの発信内容、市場情報や制度情報だけでなく現場目線の切り口がとても分かりやすく、農業に関わる方にとって価値の高いメデイアだと感じました。'
      },
      {
        title: '「経営の判断材料として活用」',
        text: '施設野菜はコスト管理が重要ですが、NOUVATIONの情報は非常に具体的で、日々の経営判断の大きな助けになっています。'
      },
      {
        title: '「若手農家の強い味方」',
        text: '周囲に相談できる相手が少ない中、オンラインでこれだけ質の高い情報に触れられるのは本当にありがたいです。'
      }
    ]
  },
  {
    id: 'shinki',
    category: '(仮)20代・新規就農',
    items: [
      {
        title: '「次世代の最優先事業は農業だと思う」',
        text: '直接農業に携わっているわけではないのですが、祖父母が小さく農業を営んでいて、情報収集の一環としてフォローさせていただきました！個人的にも次世代の最優先事業は農業だと思うのでノーベーションさんには頑張っていただきたいです！！'
      },
      {
        title: '「就農前の不安が解消されました」',
        text: '農業を始めるにあたって何から手をつければいいか不安でしたが、NOUVATIONのAIサポートやメディアを通じて、具体的なイメージが持てるようになりました。'
      },
      {
        title: '「SNSでの繋がりが励みに」',
        text: 'Instagramでの発信を見ていると、同じ志を持つ仲間が全国にいると感じられ、モチベーションの維持に繋がっています。'
      }
    ]
  },
  {
    id: 'roji',
    category: '(仮)50代・露地栽培',
    items: [
      {
        title: '「非常に参考になる投稿」',
        text: '毎日、天候や市場価格などの情報を丁寧に更新されており、非常に参考になる投稿ばかりで、勉強させていただいております。'
      },
      {
        title: '「ベテランでも新しい発見がある」',
        text: '長年農業をやってきましたが、最新のテクノロジーや市場の動向についてはNOUVATIONから学ぶことが多いです。'
      },
      {
        title: '「市場価格の透明性が嬉しい」',
        text: 'これまでは不透明だった市場の動きが、グラフで可視化されることで、納得感のある取引ができるようになりました。'
      }
    ]
  }
];
---

<section data-section-theme="light" id="voice" class="pt-16 md:pt-24 pb-24 md:pb-32 bg-[#F0ECDE]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <!-- Section Title -->
    <div class="text-center mb-20 fade-up">
      <h2 class="text-4xl md:text-[5rem] font-bold mb-4 leading-[1.2] text-[#231815]"><span class="font-maru">VOICE</span></h2>
      <p class="text-[#231815]/70">利用者の声</p>
    </div>

    <!-- 3D Carousel Voice Groups -->
    <div class="grid md:grid-cols-3 gap-12 md:gap-8 justify-items-center">
      {voiceGroups.map((group) => (
        <div class="voice-carousel fade-up w-full max-w-[380px] md:max-w-none" data-group-id={group.id}>
          <!-- Category Header -->
          <div class="flex items-center justify-between mb-4 px-2">
            <button class="carousel-prev p-2 text-[#2e7d32] hover:opacity-50 transition-opacity" aria-label="前の声へ">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>

            <span class="font-bold text-lg text-[#231815] text-center flex-1">{group.id === 'shisetsu' ? '施設野菜' : group.id === 'shinki' ? '新規就農' : '露地栽培'}</span>

            <button class="carousel-next p-2 text-[#2e7d32] hover:opacity-50 transition-opacity" aria-label="次の声へ">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          </div>

          <!-- 3D Scene -->
          <div class="carousel-scene">
            <div class="carousel-rotor">
              {group.items.map((item, index) => (
                <div class="carousel-card" data-index={index}>
                  <div class="carousel-card-inner">
                    <div class="pt-4 px-6 text-center">
                      <span class="text-sm font-bold text-[#231815]/60">{group.category.split('・')[0]}</span>
                    </div>
                    <div class="p-6 pt-3">
                      <h3 class="font-bold text-xl mb-4 text-[#231815] min-h-[3.5rem] flex items-center justify-center text-center">{item.title}</h3>
                      <p class="text-sm text-[#231815] leading-loose opacity-80">{item.text}</p>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Dots -->
          <div class="flex justify-center gap-2 mt-4">
            {group.items.map((_, index) => (
              <div class={`carousel-dot w-1.5 h-1.5 rounded-full transition-all duration-300 ${index === 0 ? 'bg-[#2e7d32] w-4' : 'bg-[#231815]/20'}`}></div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .carousel-scene {
    perspective: 800px;
    height: 380px;
    overflow: visible;
    position: relative;
  }

  .carousel-rotor {
    width: 100%;
    height: 100%;
    position: relative;
    transform-style: preserve-3d;
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .carousel-card {
    position: absolute;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
    transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .carousel-card-inner {
    width: 100%;
    height: 100%;
    background: white;
    border-radius: 1rem;
    border: 1px solid rgba(35, 24, 21, 0.1);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    overflow-y: auto;
    display: flex;
    flex-direction: column;
  }

  /* Active card */
  .carousel-card[data-state="active"] {
    transform: translateX(0) scale(1) rotateY(0deg);
    opacity: 1;
    z-index: 3;
  }

  /* Card going left (previous) */
  .carousel-card[data-state="left"] {
    transform: translateX(-65%) scale(0.8) rotateY(35deg);
    opacity: 0.4;
    z-index: 1;
    pointer-events: none;
  }

  /* Card going right (next) */
  .carousel-card[data-state="right"] {
    transform: translateX(65%) scale(0.8) rotateY(-35deg);
    opacity: 0.4;
    z-index: 1;
    pointer-events: none;
  }

  /* Hidden cards */
  .carousel-card[data-state="hidden"] {
    transform: translateX(0) scale(0.6) rotateY(0deg);
    opacity: 0;
    z-index: 0;
    pointer-events: none;
  }
</style>

<script>
  function initVoiceCarousels() {
    const carousels = document.querySelectorAll('.voice-carousel');

    carousels.forEach(carousel => {
      const cards = carousel.querySelectorAll('.carousel-card');
      const prevBtn = carousel.querySelector('.carousel-prev') as HTMLButtonElement;
      const nextBtn = carousel.querySelector('.carousel-next') as HTMLButtonElement;
      const dots = carousel.querySelectorAll('.carousel-dot');

      let currentIndex = 0;
      const totalCards = cards.length;

      function updateCarousel() {
        cards.forEach((card, index) => {
          const el = card as HTMLElement;
          if (index === currentIndex) {
            el.setAttribute('data-state', 'active');
          } else if (index === (currentIndex - 1 + totalCards) % totalCards) {
            el.setAttribute('data-state', 'left');
          } else if (index === (currentIndex + 1) % totalCards) {
            el.setAttribute('data-state', 'right');
          } else {
            el.setAttribute('data-state', 'hidden');
          }
        });

        dots.forEach((dot, index) => {
          if (index === currentIndex) {
            dot.classList.add('bg-[#2e7d32]', 'w-4');
            dot.classList.remove('bg-[#231815]/20');
          } else {
            dot.classList.remove('bg-[#2e7d32]', 'w-4');
            dot.classList.add('bg-[#231815]/20');
          }
        });
      }

      prevBtn?.addEventListener('click', () => {
        currentIndex = (currentIndex - 1 + totalCards) % totalCards;
        updateCarousel();
      });

      nextBtn?.addEventListener('click', () => {
        currentIndex = (currentIndex + 1) % totalCards;
        updateCarousel();
      });

      // 初期状態
      updateCarousel();
    });
  }

  document.addEventListener('astro:page-load', initVoiceCarousels);
  initVoiceCarousels();
</script>
