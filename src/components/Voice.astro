---
// Voice (User Testimonials) Component

const voiceGroups = [
  {
    id: 'shisetsu',
    category: '(仮)30代・施設野菜',
    items: [
      {
        title: '「価値の高いメディアだと感じました」',
        text: 'NOUVATIONさまの発信内容、市場情報や制度情報だけでなく現場目線の切り口がとても分かりやすく、農業に関わる方にとって価値の高いメデイアだと感じました。'
      },
      {
        title: '「経営の判断材料として活用」',
        text: '施設野菜はコスト管理が重要ですが、NOUVATIONの情報は非常に具体的で、日々の経営判断の大きな助けになっています。'
      },
      {
        title: '「若手農家の強い味方」',
        text: '周囲に相談できる相手が少ない中、オンラインでこれだけ質の高い情報に触れられるのは本当にありがたいです。'
      }
    ]
  },
  {
    id: 'shinki',
    category: '(仮)20代・新規就農',
    items: [
      {
        title: '「次世代の最優先事業は農業だと思う」',
        text: '直接農業に携わっているわけではないのですが、祖父母が小さく農業を営んでいて、情報収集の一環としてフォローさせていただきました！個人的にも次世代の最優先事業は農業だと思うのでノーベーションさんには頑張っていただきたいです！！'
      },
      {
        title: '「就農前の不安が解消されました」',
        text: '農業を始めるにあたって何から手をつければいいか不安でしたが、NOUVATIONのAIサポートやメディアを通じて、具体的なイメージが持てるようになりました。'
      },
      {
        title: '「SNSでの繋がりが励みに」',
        text: 'Instagramでの発信を見ていると、同じ志を持つ仲間が全国にいると感じられ、モチベーションの維持に繋がっています。'
      }
    ]
  },
  {
    id: 'roji',
    category: '(仮)50代・露地栽培',
    items: [
      {
        title: '「非常に参考になる投稿」',
        text: '毎日、天候や市場価格などの情報を丁寧に更新されており、非常に参考になる投稿ばかりで、勉強させていただいております。'
      },
      {
        title: '「ベテランでも新しい発見がある」',
        text: '長年農業をやってきましたが、最新のテクノロジーや市場の動向についてはNOUVATIONから学ぶことが多いです。'
      },
      {
        title: '「市場価格の透明性が嬉しい」',
        text: 'これまでは不透明だった市場の動きが、グラフで可視化されることで、納得感のある取引ができるようになりました。'
      }
    ]
  }
];
---

<section data-section-theme="light" id="voice" class="pt-16 md:pt-24 pb-24 md:pb-32 bg-[#F0ECDE]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <!-- Section Title -->
    <div class="text-center mb-20 fade-up">
      <h2 class="text-4xl md:text-[5rem] font-bold mb-4 leading-[1.2] text-[#231815]"><span class="font-maru">VOICE</span></h2>
      <p class="text-[#231815]/70">利用者の声</p>
    </div>

    <!-- Voice Groups Grid -->
    <div class="grid md:grid-cols-3 gap-12 md:gap-8">
      {voiceGroups.map((group) => (
        <div class="voice-slider-container fade-up" data-group-id={group.id}>
          <!-- Category Header with Arrows -->
          <div class="flex items-center justify-between mb-6 px-2">
            <button class="prev-btn p-2 text-[#2e7d32] hover:opacity-50 transition-opacity disabled:opacity-20" aria-label="前の声へ">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
            
            <span class="font-bold text-lg text-[#231815] text-center flex-1">{group.id === 'shisetsu' ? '施設野菜' : group.id === 'shinki' ? '新規就農' : '露地栽培'}</span>
            
            <button class="next-btn p-2 text-[#2e7d32] hover:opacity-50 transition-opacity disabled:opacity-20" aria-label="次の声へ">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          </div>

          <!-- Slider Track Container -->
          <div class="overflow-hidden rounded-2xl shadow-sm bg-white border border-[#231815]/10">
            <!-- Age Label (Static for now as per request) -->
            <div class="pt-8 px-8 text-center">
              <span class="text-sm font-bold text-[#231815]/60">{group.category.split('・')[0]}</span>
            </div>

            <div class="slider-track flex transition-transform duration-500 ease-out">
              {group.items.map((item) => (
                <div class="slider-item min-w-full p-8 pt-4">
                  <h3 class="font-bold text-xl mb-4 text-[#231815] min-h-[3.5rem] flex items-center justify-center text-center">{item.title}</h3>
                  <p class="text-sm text-[#231815] leading-loose opacity-80 text-center">{item.text}</p>
                </div>
              ))}
            </div>
          </div>

          <!-- Dots Indicator -->
          <div class="flex justify-center gap-2 mt-6">
            {group.items.map((_, index) => (
              <div class={`dot w-1.5 h-1.5 rounded-full transition-all duration-300 ${index === 0 ? 'bg-[#2e7d32] w-4' : 'bg-[#231815]/20'}`}></div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  function initVoiceSliders() {
    const containers = document.querySelectorAll('.voice-slider-container');
    
    containers.forEach(container => {
      const track = container.querySelector('.slider-track') as HTMLElement;
      const items = container.querySelectorAll('.slider-item');
      const prevBtn = container.querySelector('.prev-btn') as HTMLButtonElement;
      const nextBtn = container.querySelector('.next-btn') as HTMLButtonElement;
      const dots = container.querySelectorAll('.dot');
      
      let currentIndex = 0;
      const totalItems = items.length;

      function updateSlider() {
        // スライド移動
        track.style.transform = `translateX(-${currentIndex * 100}%)`;
        
        // ボタンの状態更新
        prevBtn.disabled = currentIndex === 0;
        nextBtn.disabled = currentIndex === totalItems - 1;
        
        // ドットの更新
        dots.forEach((dot, index) => {
          if (index === currentIndex) {
            dot.classList.add('bg-[#2e7d32]', 'w-4');
            dot.classList.remove('bg-[#231815]/20');
          } else {
            dot.classList.remove('bg-[#2e7d32]', 'w-4');
            dot.classList.add('bg-[#231815]/20');
          }
        });
      }

      prevBtn.addEventListener('click', () => {
        if (currentIndex > 0) {
          currentIndex--;
          updateSlider();
        }
      });

      nextBtn.addEventListener('click', () => {
        if (currentIndex < totalItems - 1) {
          currentIndex++;
          updateSlider();
        }
      });

      // 初期状態の反映
      updateSlider();
    });
  }

  // Astroのライフサイクルに合わせて初期化
  document.addEventListener('astro:page-load', initVoiceSliders);
  // 初回読み込み時
  initVoiceSliders();
</script>
