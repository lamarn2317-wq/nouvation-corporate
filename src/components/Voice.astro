---
// Voice - 利用者の声 | Premium Green × Postcard

const categories = [
  {
    id: 'shisetsu',
    label: '施設野菜',
    items: [
      { age: '30代', quote: '価値の高いメディアだと感じました', text: 'NOUVATIONさまの発信内容、市場情報や制度情報だけでなく現場目線の切り口がとても分かりやすく、農業に関わる方にとって価値の高いメデイアだと感じました。' },
      { age: '30代', quote: '経営の判断材料として活用', text: '施設野菜はコスト管理が重要ですが、NOUVATIONの情報は非常に具体的で、日々の経営判断の大きな助けになっています。' },
      { age: '40代', quote: '若手農家の強い味方', text: '周囲に相談できる相手が少ない中、オンラインでこれだけ質の高い情報に触れられるのは本当にありがたいです。' },
    ]
  },
  {
    id: 'roji',
    label: '露地栽培',
    items: [
      { age: '50代', quote: '非常に参考になる投稿', text: '毎日、天候や市場価格などの情報を丁寧に更新されており、非常に参考になる投稿ばかりで、勉強させていただいております。' },
      { age: '50代', quote: 'ベテランでも新しい発見がある', text: '長年農業をやってきましたが、最新のテクノロジーや市場の動向についてはNOUVATIONから学ぶことが多いです。' },
      { age: '40代', quote: '市場価格の透明性が嬉しい', text: 'これまでは不透明だった市場の動きが、グラフで可視化されることで、納得感のある取引ができるようになりました。' },
    ]
  },
  {
    id: 'shinki',
    label: '新規就農',
    items: [
      { age: '20代', quote: '次世代の最優先事業は農業だと思う', text: '直接農業に携わっているわけではないのですが、祖父母が小さく農業を営んでいて、情報収集の一環としてフォローさせていただきました！個人的にも次世代の最優先事業は農業だと思うのでノーベーションさんには頑張っていただきたいです！！' },
      { age: '20代', quote: '就農前の不安が解消されました', text: '農業を始めるにあたって何から手をつければいいか不安でしたが、NOUVATIONのAIサポートやメディアを通じて、具体的なイメージが持てるようになりました。' },
      { age: '20代', quote: 'SNSでの繋がりが励みに', text: 'Instagramでの発信を見ていると、同じ志を持つ仲間が全国にいると感じられ、モチベーションの維持に繋がっています。' },
    ]
  }
];
---

<section data-section-theme="light" id="voice" class="voice-section">
  <!-- 背景レイヤー -->
  <div class="vbg" aria-hidden="true">
    <div class="vbg__grad"></div>
    <div class="vbg__shine"></div>
    <div class="vbg__leaf vbg__leaf--1"></div>
    <div class="vbg__leaf vbg__leaf--2"></div>
  </div>

  <div class="voice-container">
    <div class="voice-header" data-voice-anim>
      <p class="voice-eyebrow">VOICE</p>
      <h2 class="voice-heading">利 用 者 の 声</h2>
    </div>

    <div class="voice-tabs" data-voice-anim>
      {categories.map((cat, i) => (
        <button class={`voice-tab ${i === 0 ? 'is-active' : ''}`} data-tab={cat.id}>{cat.label}</button>
      ))}
    </div>

    <div class="voice-panels">
      {categories.map((cat, ci) => (
        <div class={`voice-panel ${ci === 0 ? 'is-active' : ''}`} data-panel={cat.id}>
          <div class="voice-stage" data-voice-anim>
            <!-- Swipe Indicator Arrows -->
            <button class="voice-arrow voice-arrow--prev" data-arrow="prev" aria-label="前のカードへ">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
            <button class="voice-arrow voice-arrow--next" data-arrow="next" aria-label="次のカードへ">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 6 15 12 9 18"></polyline>
              </svg>
            </button>

            <div class="voice-carousel">
              {cat.items.map((item, i) => (
                <article class={`voice-card ${i === 0 ? 'is-current' : ''}`} data-ci={i}>
                  <div class="card-face">
                    <div class="card-header">
                      <span class="card-age">{item.age}</span>
                    </div>
                    <div class="card-body-area">
                      <p class="card-deco">"</p>
                      <h3 class="card-quote">{item.quote}</h3>
                      <p class="card-body">{item.text}</p>
                    </div>
                  </div>
                </article>
              ))}
            </div>

            <!-- Swipe hint (SP only, fades after first interaction) -->
            <div class="voice-swipe-hint" aria-hidden="true">
              <span class="vsh-icon">
                <svg viewBox="0 0 32 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 26 12 20 18"></polyline>
                  <polyline points="12 6 6 12 12 18" opacity="0.6"></polyline>
                </svg>
              </span>
              <span class="vsh-text">SWIPE</span>
            </div>
          </div>

          <div class="voice-indicators" data-voice-anim>
            {cat.items.map((_, i) => (
              <button class={`voice-dot ${i === 0 ? 'is-active' : ''}`} data-goto={i} aria-label={`${i + 1}番目`}></button>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* ===== Section ===== */
  .voice-section {
    position: relative;
    padding: 7rem 0 8rem;
    overflow: hidden;
    isolation: isolate;
  }

  /* ===== Background ===== */
  .vbg { position: absolute; inset: 0; pointer-events: none; }

  .vbg__grad {
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg,
      #0d3320 0%,
      #1b5e3a 25%,
      #267a4a 48%,
      #3da564 72%,
      #6dce88 90%,
      #8ddfa0 100%
    );
  }

  /* 光沢シャイン */
  .vbg__shine {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 50% at 30% 20%, rgba(255,255,255,0.08) 0%, transparent 60%),
      radial-gradient(ellipse 40% 30% at 80% 80%, rgba(255,255,255,0.04) 0%, transparent 50%);
  }

  /* 葉っぱシルエット */
  .vbg__leaf {
    position: absolute;
    border-radius: 0 100% 0 100%;
    background: rgba(255,255,255,0.03);
    animation: leafSway 12s ease-in-out infinite;
  }
  .vbg__leaf--1 {
    width: 260px; height: 260px;
    top: -60px; left: -40px;
    transform: rotate(20deg);
  }
  .vbg__leaf--2 {
    width: 200px; height: 200px;
    bottom: -40px; right: -20px;
    transform: rotate(-30deg);
    animation-delay: -6s;
  }
  @keyframes leafSway {
    0%,100% { transform: rotate(20deg) scale(1); }
    50% { transform: rotate(25deg) scale(1.05); }
  }

  /* ===== Container ===== */
  .voice-container {
    position: relative;
    z-index: 1;
    max-width: 960px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* ===== Header ===== */
  .voice-header { text-align: center; margin-bottom: 2.5rem; }

  .voice-eyebrow {
    font-size: clamp(2.4rem, 6vw, 3.8rem);
    font-weight: 800;
    letter-spacing: 0.18em;
    color: #fff;
    line-height: 1;
    text-shadow:
      0 2px 0 rgba(0,0,0,0.15),
      0 4px 30px rgba(0,0,0,0.2);
  }

  .voice-heading {
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.35em;
    color: rgba(255,255,255,0.7);
    margin-top: 0.7rem;
  }

  /* ===== Tabs ===== */
  .voice-tabs {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .voice-tab {
    padding: 0.5rem 1.5rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.75);
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.25);
    border-radius: 100px;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    backdrop-filter: blur(8px);
  }
  .voice-tab:hover {
    color: #fff;
    background: rgba(255,255,255,0.22);
  }
  .voice-tab.is-active {
    color: #1b5e3a;
    background: #fff;
    border-color: #fff;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
    font-weight: 700;
  }

  /* ===== Panels ===== */
  .voice-panels { position: relative; min-height: 500px; }
  .voice-panel { display: none; }
  .voice-panel.is-active {
    display: block;
    animation: panelIn 0.4s cubic-bezier(0.22,1,0.36,1);
  }
  @keyframes panelIn {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ===== Stage + Carousel ===== */
  .voice-stage {
    position: relative;
    height: 540px;
    perspective: 1600px;
    perspective-origin: 50% 50%;
    /* GPU合成 */
    transform: translateZ(0);
    -webkit-transform: translateZ(0);
  }

  .voice-carousel {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    -webkit-transform-style: preserve-3d;
    touch-action: pan-y;
    user-select: none;
    cursor: grab;
    /* GPU合成・カクつき防止 */
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .voice-carousel:active { cursor: grabbing; }

  /* ===== Swipe Arrows ===== */
  .voice-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: rgba(255, 255, 255, 0.85);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition:
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.18);
    -webkit-tap-highlight-color: transparent;
  }
  .voice-arrow svg {
    width: 22px;
    height: 22px;
  }
  .voice-arrow:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.45);
    box-shadow: 0 6px 22px rgba(0, 0, 0, 0.25), 0 0 16px rgba(255, 255, 255, 0.15);
    color: #fff;
  }
  .voice-arrow:active {
    transform: translateY(-50%) scale(0.92);
  }
  .voice-arrow--prev {
    left: 0.5rem;
    animation: arrowPulseLeft 2.6s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  .voice-arrow--next {
    right: 0.5rem;
    animation: arrowPulseRight 2.6s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    animation-delay: 1.3s;
  }
  @keyframes arrowPulseLeft {
    0%, 100% { transform: translateY(-50%) translateX(0); }
    50%      { transform: translateY(-50%) translateX(-4px); }
  }
  @keyframes arrowPulseRight {
    0%, 100% { transform: translateY(-50%) translateX(0); }
    50%      { transform: translateY(-50%) translateX(4px); }
  }
  /* スワイプヒント — 数秒で消える */
  .voice-swipe-hint {
    position: absolute;
    bottom: -8px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.85rem;
    border-radius: 100px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    font-weight: 700;
    pointer-events: none;
    z-index: 10;
    animation: swipeHint 3s ease-in-out 0.8s infinite;
  }
  .voice-swipe-hint.is-hidden {
    opacity: 0;
    transform: translateX(-50%) translateY(8px);
    transition: opacity 0.5s ease, transform 0.5s ease;
    animation: none;
  }
  .vsh-icon { display: inline-flex; }
  .vsh-icon svg { width: 22px; height: 16px; }
  @keyframes swipeHint {
    0%, 100% { transform: translateX(-50%); opacity: 0.85; }
    50%      { transform: translateX(-44%); opacity: 1; }
  }

  /* ===== Card ===== */
  .voice-card {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 330px;
    transform: translate3d(-50%, -50%, -200px) scale(0.5) rotateY(0deg);
    opacity: 0;
    /* Apple級スプリング感のイージング（cubic-bezier調整） */
    transition:
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      opacity   0.55s cubic-bezier(0.22, 1, 0.36, 1),
      filter    0.55s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform, opacity, filter;
    pointer-events: none;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transform-style: preserve-3d;
    -webkit-transform-style: preserve-3d;
  }

  /* 前面 — 大きく浮かび上がる */
  .voice-card.is-current {
    transform: translate3d(-50%, -50%, 0px) scale(1.05) rotateY(0deg);
    opacity: 1;
    z-index: 3;
    pointer-events: auto;
    filter: drop-shadow(0 30px 50px rgba(0,0,0,0.35));
    animation: cardFloat 5s ease-in-out infinite;
  }

  /* 右 — 遠ざかる */
  .voice-card.is-next {
    transform: translate3d(18%, -50%, -180px) scale(0.55) rotateY(-22deg);
    opacity: 0.45;
    z-index: 2;
    filter: brightness(0.85);
    pointer-events: auto;
  }

  /* 左 — 遠ざかる */
  .voice-card.is-prev {
    transform: translate3d(-118%, -50%, -180px) scale(0.55) rotateY(22deg);
    opacity: 0.45;
    z-index: 2;
    filter: brightness(0.85);
    pointer-events: auto;
  }

  .voice-card.is-hidden {
    transform: translate3d(-50%, -50%, -300px) scale(0.4) rotateY(0deg);
    opacity: 0;
    z-index: 0;
    pointer-events: none;
  }

  /* ドラッグ中（一切のtransition/animationを切ってフレーム単位制御） */
  .voice-card.is-dragging {
    transition: none !important;
    animation: none !important;
  }
  /* 慣性復帰時のスプリングカーブ */
  .voice-card.is-springing {
    transition: transform 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) !important;
    animation: none !important;
  }

  .voice-card.no-anim {
    transition: none !important;
    animation: none !important;
  }

  /* ===== カード位置遷移のみ（3D回転なし・カード向き完全固定） ===== */
  .voice-carousel.drum-fwd,
  .voice-carousel.drum-bwd {
    transform-style: preserve-3d;
    -webkit-transform-style: preserve-3d;
  }
  /* サイクル中（高速）：カードは流れるように位置遷移 */
  .voice-carousel.is-rapid .voice-card {
    transition:
      transform 0.1s cubic-bezier(0.4, 0, 0.6, 1),
      opacity   0.08s linear !important;
    animation: none !important;
    will-change: transform, opacity;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  /* 🌟 サイクル中は3枚とも同じサイズ・同じ向き → スケール変化のブレを排除 */
  .voice-carousel.is-rapid .voice-card.is-current {
    transform: translate3d(-50%, -50%, -80px) scale(0.7) rotateY(0deg) !important;
    opacity: 0.85 !important;
    filter: brightness(0.92) !important;
  }
  .voice-carousel.is-rapid .voice-card.is-prev {
    transform: translate3d(-118%, -50%, -80px) scale(0.7) rotateY(0deg) !important;
    opacity: 0.85 !important;
    filter: brightness(0.92) !important;
  }
  .voice-carousel.is-rapid .voice-card.is-next {
    transform: translate3d(18%, -50%, -80px) scale(0.7) rotateY(0deg) !important;
    opacity: 0.85 !important;
    filter: brightness(0.92) !important;
  }
  .voice-carousel.is-rapid .voice-card.is-hidden {
    transform: translate3d(-50%, -50%, -80px) scale(0.7) rotateY(0deg) !important;
    opacity: 0 !important;
  }

  /* 着地（最終ステップ）：滑らかに前面カードが大きくなる */
  .voice-carousel.drum-fwd .voice-card,
  .voice-carousel.drum-bwd .voice-card {
    transition:
      transform 0.65s cubic-bezier(0.22, 1, 0.36, 1),
      opacity   0.5s cubic-bezier(0.22, 1, 0.36, 1),
      filter    0.45s cubic-bezier(0.22, 1, 0.36, 1) !important;
    animation: none !important;
    will-change: transform, opacity;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  /* 各カード自身もGPUレイヤを強制 */
  .voice-carousel.drum-fwd .voice-card,
  .voice-carousel.drum-bwd .voice-card,
  .voice-carousel.drum-fwd .card-face,
  .voice-carousel.drum-bwd .card-face {
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  /* 回転中は背景アニメも止めて GPU を回転に集中させる */
  .voice-section.is-spinning .vbg__leaf,
  .voice-section.is-spinning .voice-arrow {
    animation: none !important;
  }

  @keyframes cardFloat {
    0%,100% { transform: translate3d(-50%, -50%, 0px) scale(1.05) rotateY(0deg); }
    50%      { transform: translate3d(-50%, calc(-50% - 9px), 0px) scale(1.05) rotateY(0deg); }
  }

  /* ===== Card Face ===== */
  .card-face {
    background: rgba(255, 255, 255, 0.96);
    border-radius: 1rem;
    border: 1px solid rgba(255,255,255,0.8);
    box-shadow:
      0 2px 0 rgba(255,255,255,1) inset,
      0 20px 50px rgba(0,0,0,0.18);
    display: flex;
    flex-direction: column;
    min-height: 400px;
  }

  /* ===== Card Header ===== */
  .card-header {
    padding: 1.4rem 1.6rem 0.6rem;
  }

  /* 年代バッジ */
  .card-age {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #1b5e3a;
    padding: 0.25rem 0.8rem;
    background: rgba(47,143,85,0.1);
    border: 1px solid rgba(47,143,85,0.25);
    border-radius: 100px;
    display: inline-block;
  }

  /* 本文エリア */
  .card-body-area {
    padding: 0.4rem 1.6rem 1.6rem;
    flex: 1;
  }

  .card-deco {
    font-size: 3.2rem;
    font-weight: 700;
    line-height: 1;
    color: rgba(47,143,85,0.15);
    font-family: Georgia, serif;
    margin-bottom: -0.6rem;
    user-select: none;
  }

  .card-quote {
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.65;
    color: #1a3d28;
    margin-bottom: 0.9rem;
  }

  .card-body {
    font-size: 0.78rem;
    line-height: 1.9;
    color: #3a5a45;
  }

  /* ===== Indicators ===== */
  .voice-indicators {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 1.2rem;
  }

  .voice-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    border: none; padding: 0;
    background: rgba(255,255,255,0.35);
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.22,1,0.36,1);
  }
  .voice-dot.is-active {
    width: 28px;
    border-radius: 100px;
    background: rgba(255,255,255,0.9);
    box-shadow: 0 0 14px rgba(255,255,255,0.35);
  }

  /* ===== Scroll Reveal ===== */
  [data-voice-anim] {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.7s cubic-bezier(0.22,1,0.36,1),
                transform 0.7s cubic-bezier(0.22,1,0.36,1);
  }
  [data-voice-anim].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ===== Responsive ===== */
  @media (max-width: 640px) {
    .voice-section { padding: 4rem 0 4.5rem; }
    .voice-container { padding: 0 1rem; }
    .voice-eyebrow { font-size: 2rem; letter-spacing: 0.12em; }
    .voice-heading { font-size: 0.72rem; letter-spacing: 0.25em; }
    .voice-tabs { gap: 0.35rem; }
    .voice-tab { padding: 0.4rem 1rem; font-size: 0.72rem; }
    .voice-stage { height: 440px; }
    .voice-card { width: 240px; }
    .card-face { min-height: 320px; }
    .card-header { padding: 1.1rem 1.3rem 0.5rem; }
    .card-body-area { padding: 0.4rem 1.3rem 1.3rem; }
    .card-quote { font-size: 0.95rem; line-height: 1.6; }
    .card-body { font-size: 0.8rem; line-height: 1.85; }
  }
</style>

<script>
  function initVoice() {
    // 二重初期化を防ぐ（astro:page-load と直接呼び出しの両方で発火する場合に対応）
    const section = document.getElementById('voice');
    if (!section || (section as any)._vi) return;
    (section as any)._vi = true;

    const tabs   = document.querySelectorAll('.voice-tab')   as NodeListOf<HTMLElement>;
    const panels = document.querySelectorAll('.voice-panel') as NodeListOf<HTMLElement>;

    // タブクリックリスナー（一度だけ登録）
    tabs.forEach(tab => {
      const onTabClick = () => {
        const id = tab.dataset.tab;
        tabs.forEach(t => t.classList.remove('is-active'));
        tab.classList.add('is-active');
        panels.forEach(p => {
          p.classList.remove('is-active');
          if (p.dataset.panel === id) { p.classList.add('is-active'); initCarousel(p); }
        });
      };
      tab.addEventListener('click', onTabClick);
    });

    panels.forEach(p => { if (p.classList.contains('is-active')) initCarousel(p); });

    function initCarousel(panel: HTMLElement) {
      // 前回のクリーンアップを実行（累積イベント防止）
      if ((panel as any)._vc_cleanup) (panel as any)._vc_cleanup();

      const cards = panel.querySelectorAll('.voice-card') as NodeListOf<HTMLElement>;
      const dots  = panel.querySelectorAll('.voice-dot')  as NodeListOf<HTMLElement>;
      const car   = panel.querySelector('.voice-carousel') as HTMLElement;
      const total = cards.length;
      let current = 0;
      let isDragging = false;
      let startX = 0;
      let dx = 0;

      function update() {
        cards.forEach((card, i) => {
          card.classList.remove('is-current','is-next','is-prev','is-hidden','no-anim');
          if      (i === current)                       card.classList.add('is-current');
          else if (i === (current + 1) % total)         card.classList.add('is-next');
          else if (i === (current - 1 + total) % total) card.classList.add('is-prev');
          else                                          card.classList.add('is-hidden');
        });
        dots.forEach((d, i) => d.classList.toggle('is-active', i === current));
      }

      // 高速サイクル（9周）→ スムーズ着地：カード位置遷移のみ、3D回転なし
      let isSpinning = false;
      const voiceSection = document.getElementById('voice');
      function drumTo(newIndex: number, dir: number) {
        if (isSpinning) return;
        isSpinning = true;

        const cls = dir >= 0 ? 'drum-fwd' : 'drum-bwd';
        car.classList.add(cls);
        car.classList.add('is-rapid');           // 高速トランジション ON
        voiceSection?.classList.add('is-spinning');

        // 9周分の class 入替（CYCLES * total = 27ステップ）→ +1で着地 = 28ステップ
        const CYCLES = 9;
        const finalIndex = newIndex;
        const TOTAL_STEPS = CYCLES * total + 1;
        let step = 0;

        function nextStep() {
          if (step >= TOTAL_STEPS - 1) {
            // 最終ステップ: is-rapid を外して 0.65s transition で「フワッ」と前面大きく
            car.classList.remove('is-rapid');
            current = finalIndex;
            update();
            setTimeout(() => {
              car.classList.remove('drum-fwd', 'drum-bwd');
              voiceSection?.classList.remove('is-spinning');
              isSpinning = false;
            }, 700);
            return;
          }

          // 高速サイクル中 — 1ステップずつ位置を進める
          current = (current + dir + total) % total;
          update();
          step++;

          // 序盤マッハ→終盤少しゆっくり（着地手前で減速）
          const t = step / (TOTAL_STEPS - 1);
          // 35ms から始まり 80ms へ ease-in（合計約1.5s）
          const dur = 35 + Math.pow(t, 2) * 45;
          setTimeout(nextStep, dur);
        }

        nextStep();
      }

      // ドットクリック（クリーンアップ対象）
      const dotHandlers: Array<{el: HTMLElement, fn: () => void}> = [];
      dots.forEach((d, i) => {
        const fn = () => {
          const dir = i > current ? 1 : -1;
          drumTo(i, dir);
        };
        d.addEventListener('click', fn);
        dotHandlers.push({ el: d, fn });
      });

      // 矢印ボタン（クリーンアップ対象）
      const arrowHandlers: Array<{el: HTMLElement, fn: (e: Event) => void}> = [];
      const stage = panel.querySelector('.voice-stage') as HTMLElement;
      const arrowPrev = stage?.querySelector('[data-arrow="prev"]') as HTMLElement | null;
      const arrowNext = stage?.querySelector('[data-arrow="next"]') as HTMLElement | null;
      if (arrowPrev) {
        const fn = (e: Event) => {
          e.preventDefault();
          e.stopPropagation();
          drumTo((current - 1 + total) % total, -1);
          // スワイプヒントを消す
          const hint = stage?.querySelector('.voice-swipe-hint') as HTMLElement;
          if (hint) hint.classList.add('is-hidden');
        };
        arrowPrev.addEventListener('click', fn);
        arrowHandlers.push({ el: arrowPrev, fn });
      }
      if (arrowNext) {
        const fn = (e: Event) => {
          e.preventDefault();
          e.stopPropagation();
          drumTo((current + 1) % total, 1);
          const hint = stage?.querySelector('.voice-swipe-hint') as HTMLElement;
          if (hint) hint.classList.add('is-hidden');
        };
        arrowNext.addEventListener('click', fn);
        arrowHandlers.push({ el: arrowNext, fn });
      }

      // カードクリック（クリーンアップ対象）
      const cardHandlers: Array<{el: HTMLElement, fn: () => void}> = [];
      cards.forEach((card) => {
        const fn = () => {
          if (Math.abs(dx) > 8) return;
          if (card.classList.contains('is-next')) drumTo((current+1)%total, 1);
          else if (card.classList.contains('is-prev')) drumTo((current-1+total)%total, -1);
        };
        card.addEventListener('click', fn);
        cardHandlers.push({ el: card, fn });
      });

      // ===== Drag / Swipe（速度追跡＋慣性付き） =====
      let lastX = 0;
      let lastT = 0;
      let velocity = 0; // px/ms
      let rafId: number | null = null;
      let pendingX: number | null = null;

      function dragStart(x: number) {
        isDragging = true;
        startX = x;
        dx = 0;
        lastX = x;
        lastT = performance.now();
        velocity = 0;
        // 関連するすべてのカードに dragging を適用（スムーズな部分追従用）
        cards.forEach(c => {
          c.classList.add('is-dragging');
          c.classList.remove('is-springing');
        });
        const ac = car.querySelector('.is-current') as HTMLElement;
        if (ac) ac.style.willChange = 'transform';
      }

      function applyDragFrame() {
        rafId = null;
        if (!isDragging || pendingX === null) return;
        const x = pendingX;
        pendingX = null;

        const now = performance.now();
        const elapsed = Math.max(1, now - lastT);
        velocity = (x - lastX) / elapsed; // px/ms
        lastX = x;
        lastT = now;
        dx = x - startX;

        const absDx = Math.abs(dx);

        // 抵抗（drag-resistance）— 大きく動くほど鈍くする
        const resistDx = dx * (1 - Math.min(absDx / 800, 0.3));

        const ac = car.querySelector('.is-current') as HTMLElement;
        if (ac) {
          const rot = resistDx * -0.022;
          const scl = Math.max(1.05 - absDx * 0.00035, 0.95);
          const tY = absDx * 0.025;
          ac.style.transform = `translate3d(calc(-50% + ${resistDx}px), calc(-50% + ${tY}px), 0) scale(${scl}) rotateY(${rot}deg)`;
        }

        // ドラッグ中、隣のカードもわずかに反応させる（プレビュー感）
        const next = car.querySelector('.is-next') as HTMLElement;
        const prev = car.querySelector('.is-prev') as HTMLElement;
        const peekShift = Math.max(-1, Math.min(1, dx / 200)); // -1..1
        if (next) {
          // dxが負（左にドラッグ） → next が前に出る
          const peek = -peekShift; // 0..1 に
          const opa = 0.45 + Math.max(0, peek) * 0.45;
          next.style.transform = `translate3d(calc(18% - ${peek * 80}px), -50%, ${-180 + peek * 100}px) scale(${0.55 + peek * 0.15}) rotateY(${-22 + peek * 12}deg)`;
          next.style.opacity = String(opa);
        }
        if (prev) {
          const peek = peekShift; // -1..1
          const opa = 0.45 + Math.max(0, peek) * 0.45;
          prev.style.transform = `translate3d(calc(-118% + ${peek * 80}px), -50%, ${-180 + peek * 100}px) scale(${0.55 + peek * 0.15}) rotateY(${22 - peek * 12}deg)`;
          prev.style.opacity = String(opa);
        }
      }

      function dragMove(x: number) {
        if (!isDragging) return;
        pendingX = x;
        if (rafId === null) rafId = requestAnimationFrame(applyDragFrame);
      }

      function clearInlineStyles() {
        cards.forEach(c => {
          c.classList.remove('is-dragging', 'is-springing');
          c.style.transform = '';
          c.style.opacity = '';
          c.style.willChange = '';
        });
      }

      function dragEnd() {
        if (!isDragging) return;
        isDragging = false;
        if (rafId !== null) { cancelAnimationFrame(rafId); rafId = null; }
        pendingX = null;

        const absDx = Math.abs(dx);
        const absV = Math.abs(velocity); // px/ms

        // 慣性しきい値: 距離 > 55px か 速度 > 0.5 px/ms（≒ flick）
        const shouldAdvance = absDx > 55 || absV > 0.5;

        if (shouldAdvance) {
          // スプリングで現在カードを画面外まで送る感じにしてからdrumTo
          const dir = dx < 0 ? 1 : -1;
          // 即座に位置リセットしてdrumTo（drum-fwd/bwdのCSSアニメーションが滑らかに繋がる）
          clearInlineStyles();
          drumTo((current + dir + total) % total, dir);
        } else {
          // キャンセル: スプリングで元位置に戻す
          cards.forEach(c => {
            c.classList.remove('is-dragging');
            c.classList.add('is-springing');
            c.style.transform = '';
            c.style.opacity = '';
          });
          // springing クラスを 600ms 後に外す
          setTimeout(() => {
            cards.forEach(c => c.classList.remove('is-springing'));
          }, 600);
        }

        dx = 0;
        velocity = 0;
      }

      // Touch
      const onTS = (e: TouchEvent) => dragStart(e.touches[0].clientX);
      const onTM = (e: TouchEvent) => dragMove(e.touches[0].clientX);
      const onTE = () => dragEnd();
      car.addEventListener('touchstart', onTS as EventListener, { passive: true });
      car.addEventListener('touchmove',  onTM as EventListener, { passive: true });
      car.addEventListener('touchend',   onTE, { passive: true });

      // PC Mouse drag
      const onMD = (e: MouseEvent) => { e.preventDefault(); dragStart(e.clientX); };
      const onMM = (e: MouseEvent) => { if (isDragging) dragMove(e.clientX); };
      const onMU = () => { if (isDragging) dragEnd(); };
      const onDS = (e: Event) => e.preventDefault();
      const onSS = (e: Event) => { if (isDragging) e.preventDefault(); };
      car.addEventListener('mousedown', onMD as EventListener);
      car.addEventListener('dragstart', onDS);
      document.addEventListener('mousemove',   onMM as EventListener);
      document.addEventListener('mouseup',     onMU);
      document.addEventListener('selectstart', onSS);

      // クリーンアップ登録（全リスナーを確実に解除）
      (panel as any)._vc_cleanup = () => {
        dotHandlers.forEach(({ el, fn }) => el.removeEventListener('click', fn));
        cardHandlers.forEach(({ el, fn }) => el.removeEventListener('click', fn));
        arrowHandlers.forEach(({ el, fn }) => el.removeEventListener('click', fn));
        car.removeEventListener('touchstart', onTS as EventListener);
        car.removeEventListener('touchmove',  onTM as EventListener);
        car.removeEventListener('touchend',   onTE);
        car.removeEventListener('mousedown',  onMD as EventListener);
        car.removeEventListener('dragstart',  onDS);
        document.removeEventListener('mousemove',   onMM as EventListener);
        document.removeEventListener('mouseup',     onMU);
        document.removeEventListener('selectstart', onSS);
      };

      update();
    }

    // Scroll reveal
    const obs = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('is-visible'); });
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('[data-voice-anim]').forEach(el => obs.observe(el));
  }

  // astro:page-load は初回ロード・View Transitions 両方で発火
  // _vi フラグで二重実行を防止しているため直接呼び出しも安全
  document.addEventListener('astro:page-load', () => {
    const s = document.getElementById('voice');
    if (s) delete (s as any)._vi; // ページ遷移時はフラグリセット
    initVoice();
  });
  initVoice();
</script>
