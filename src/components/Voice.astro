---
// Voice - 利用者の声 | Premium Green × 静謐ミニマル

const categories = [
  {
    id: 'shinki',
    label: '新規就農',
    items: [
      { age: '30代 / 兼業農家', quote: '脱サラして新規就農する予定です', text: '今はサラリーマンをしながら週末農家として野菜を栽培しています。今後脱サラして新規就農する予定です。農業をもっと身近に、もっと魅力あるものにしていければと思っています。' },
      { age: '20代 / 研修中', quote: '補助金情報を知りたくてフォロー', text: '現在いちご農家になるため研修中です。新規就農するにあたり、いちごの高設栽培の初期費用が高額なため、どのような補助金があるのか気になり、フォローさせていただきました。' },
      { age: '30代 / 新規就農(就農済み)', quote: 'まだまだ学ばせてください', text: '新規就農しました。まだまだ無知なことが多いので、色々と学ばせて頂きたいと思っています。NOUVATIONさんの発信を日々の勉強に活用しています。' },
    ]
  },
  {
    id: 'kotsugi',
    label: '後継ぎ',
    items: [
      { age: '20代 / 祖父母継承', quote: '0からスタートしました', text: '私は去年、祖父母がしてきた農業を守り次へと繋げたいとおもい0からスタートしました。わからないことだらけですので大変有難いコミュニティです！' },
      { age: '20代 / 祖父ぶどう園後継ぎ', quote: '再来年、後継ぎをしようと考えています', text: '現在、祖父がぶどう園を経営しており、再来年に後継ぎをしようと考えています。最近、助成金や補助金などを調べていました。NOUVATION様の投稿などを参考にさせていただいています。' },
      { age: '40代 / 兼業×両親手伝い', quote: '自分の関わりを増やさないと', text: '専業ではなく、両親の田んぼを手伝いしています。最近、両親の体力の低下が気になり、そろそろ自分の関わりを増やさないといけないなと考えています。仕事をしているのでどうしたら良いものかと考えているうちにNOUVATIONに辿り着きました。' },
    ]
  },
  {
    id: 'shisetsu',
    label: '施設野菜',
    items: [
      { age: '30代', quote: '価値の高いメディアだと感じました', text: 'NOUVATIONさまの発信内容、市場情報や制度情報だけでなく現場目線の切り口がとても分かりやすく、農業に関わる方にとって価値の高いメディアだと感じました。' },
      { age: '30代', quote: '経営の判断材料として活用', text: '施設野菜はコスト管理が重要ですが、NOUVATIONの情報は非常に具体的で、日々の経営判断の大きな助けになっています。' },
      { age: '40代', quote: '若手農家の強い味方', text: '周囲に相談できる相手が少ない中、オンラインでこれだけ質の高い情報に触れられるのは本当にありがたいです。' },
    ]
  },
  {
    id: 'roji',
    label: '露地栽培',
    items: [
      { age: '30代 / 北海道 / 玉ねぎ', quote: '美しい空に癒されながら', text: '北海道で農業をしています。今玉ねぎの収穫真っ最中〜ハードな仕事ですが、美しい空に癒されながらがんばっています。農業はちゃんと稼げることが大事ですよね！' },
      { age: '30-40代 / 柑橘 / 兼業', quote: '柑橘栽培をしている兼業農家です', text: 'いつも有効な情報発信ありがとうございます！私は農業関係者です。柑橘栽培をしている兼業農家です。' },
      { age: '北海道 / 現役農家', quote: '役立つ情報が発信されていたので', text: '北海道で農家を営農してます。とても役立つ情報が発信されていたのでフォローさせて頂きました。' },
    ]
  }
];
---

<section data-section-theme="dark" id="voice" class="voice-section" aria-labelledby="voice-heading-title">
  <!-- 背景レイヤー（明るい緑グラデ＋静謐） -->
  <div class="vbg" aria-hidden="true">
    <div class="vbg__grad"></div>
    <div class="vbg__shine"></div>
    <div class="vbg__halo vbg__halo--tl"></div>
    <div class="vbg__halo vbg__halo--br"></div>
  </div>

  <div class="voice-container">
    <div class="voice-header" data-voice-anim>
      <p class="voice-eyebrow font-maru" id="voice-heading-title">VOICE</p>
      <h2 class="voice-heading">利 用 者 の 声</h2>
    </div>

    <div class="voice-tabs" role="tablist" aria-label="カテゴリ切替" data-voice-anim>
      {categories.map((cat, i) => (
        <button
          role="tab"
          id={`voice-tab-${cat.id}`}
          aria-controls={`voice-panel-${cat.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          class={`voice-tab ${i === 0 ? 'is-active' : ''}`}
          data-tab={cat.id}
        >{cat.label}</button>
      ))}
    </div>

    <div class="voice-panels">
      {categories.map((cat, ci) => (
        <div
          role="tabpanel"
          id={`voice-panel-${cat.id}`}
          aria-labelledby={`voice-tab-${cat.id}`}
          aria-roledescription="カルーセル"
          tabindex={ci === 0 ? 0 : -1}
          hidden={ci !== 0}
          class={`voice-panel ${ci === 0 ? 'is-active' : ''}`}
          data-panel={cat.id}
        >
          <div class="voice-stage" data-voice-anim>
            <!-- Swipe Indicator Arrows -->
            <button class="voice-arrow voice-arrow--prev" data-arrow="prev" aria-label="前のカードへ">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
            <button class="voice-arrow voice-arrow--next" data-arrow="next" aria-label="次のカードへ">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="9 6 15 12 9 18"></polyline>
              </svg>
            </button>

            <div class="voice-carousel" aria-live="polite" aria-atomic="false">
              {cat.items.map((item, i) => (
                <article
                  class={`voice-card ${i === 0 ? 'is-current' : ''}`}
                  data-ci={i}
                  role="group"
                  aria-roledescription="スライド"
                  aria-label={`${i + 1} / ${cat.items.length}`}
                  aria-hidden={i !== 0 ? 'true' : 'false'}
                >
                  <div class="card-face">
                    <div class="card-header">
                      <span class="card-age">{item.age}</span>
                    </div>
                    <div class="card-body-area">
                      <p class="card-deco" aria-hidden="true">"</p>
                      <h3 class="card-quote">{item.quote}</h3>
                      <p class="card-body">{item.text}</p>
                    </div>
                  </div>
                </article>
              ))}
            </div>

            <!-- Swipe hint (SP only, fades after first interaction) -->
            <div class="voice-swipe-hint" aria-hidden="true">
              <span class="vsh-icon">
                <svg viewBox="0 0 32 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 26 12 20 18"></polyline>
                  <polyline points="12 6 6 12 12 18" opacity="0.6"></polyline>
                </svg>
              </span>
              <span class="vsh-text">SWIPE</span>
            </div>
          </div>

          <div class="voice-indicators" role="tablist" aria-label={`${cat.label}のスライド選択`} data-voice-anim>
            {cat.items.map((_, i) => (
              <button
                class={`voice-dot ${i === 0 ? 'is-active' : ''}`}
                data-goto={i}
                role="tab"
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-label={`${i + 1}番目のスライドへ移動`}
                tabindex={i === 0 ? 0 : -1}
              ></button>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* ===== Section ===== */
  .voice-section {
    position: relative;
    padding: 7rem 0 8rem;
    overflow: hidden;
    isolation: isolate;
  }

  /* ===== Background（明るい緑グラデ／既存復活＋静謐） ===== */
  .vbg { position: absolute; inset: 0; pointer-events: none; }

  .vbg__grad {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg,
      #3da564 0%,
      #2a8550 18%,
      #1d6840 36%,
      #134a2d 56%,
      #0c331e 74%,
      #061b10 90%,
      #030a06 100%
    );
  }

  /* 光沢シャイン */
  .vbg__shine {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 50% at 30% 20%, rgba(255,255,255,0.08) 0%, transparent 60%),
      radial-gradient(ellipse 40% 30% at 80% 80%, rgba(255,255,255,0.04) 0%, transparent 50%);
  }

  /* 角に滲む光輪（控えめ） */
  .vbg__halo {
    position: absolute;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    background: radial-gradient(circle at center,
      rgba(255,255,255,0.08) 0%,
      rgba(255,255,255,0.025) 45%,
      transparent 75%);
    filter: blur(70px);
    pointer-events: none;
  }
  .vbg__halo--tl { top: -280px; left: -240px; }
  .vbg__halo--br { bottom: -280px; right: -220px; }


  /* ===== Container ===== */
  .voice-container {
    position: relative;
    z-index: 1;
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* ===== Header（Aesop 風セリフ＋適度な余白） ===== */
  .voice-header {
    text-align: center;
    margin-bottom: 2.6rem;
  }

  .voice-eyebrow {
    font-size: clamp(2.4rem, 6vw, 4.5rem);
    font-weight: 700;
    letter-spacing: 0.06em;
    color: rgba(255,255,255,0.96);
    line-height: 1.1;
  }

  .voice-heading {
    font-size: 0.78rem;
    font-weight: 400;
    letter-spacing: 0.55em;
    color: rgba(255,255,255,0.55);
    margin-top: 1.6rem;
    padding-left: 0.55em; /* letter-spacing 補正 */
  }

  /* ===== Tabs（Aesop 風アンダーライン式 / プレミアム） ===== */
  .voice-tabs {
    display: flex;
    justify-content: center;
    gap: 2.4rem;
    margin-bottom: 2.4rem;
    flex-wrap: wrap;
    border-top: 1px solid rgba(255,255,255,0.1);
    border-bottom: 1px solid rgba(255,255,255,0.1);
    padding: 0.7rem 0;
  }

  .voice-tab {
    position: relative;
    padding: 0.6rem 0;
    font-size: 0.85rem;
    font-weight: 400;
    letter-spacing: 0.16em;
    color: rgba(255,255,255,0.55);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: color 0.45s cubic-bezier(0.22, 1, 0.36, 1),
                text-shadow 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .voice-tab::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 0;
    height: 1px;
    background: rgba(255,255,255,0.95);
    transition: width 0.5s cubic-bezier(0.22, 1, 0.36, 1),
                left 0.5s cubic-bezier(0.22, 1, 0.36, 1),
                background 0.45s cubic-bezier(0.22, 1, 0.36, 1),
                box-shadow 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .voice-tab:hover {
    color: #B8FF1A;
    text-shadow: 0 0 14px rgba(184, 255, 26, 0.45);
  }
  .voice-tab:hover::after {
    left: 0;
    width: 100%;
    background: #B8FF1A;
    box-shadow: 0 0 10px rgba(184, 255, 26, 0.6);
  }
  .voice-tab.is-active {
    color: #fff;
    font-weight: 500;
  }
  .voice-tab.is-active::after {
    left: 0;
    width: 100%;
  }
  .voice-tab.is-active:hover {
    color: #B8FF1A;
  }

  /* ===== Panels ===== */
  .voice-panels { position: relative; min-height: 500px; }
  .voice-panel { display: none; }
  .voice-panel.is-active {
    display: block;
    animation: panelIn 0.4s cubic-bezier(0.22,1,0.36,1);
  }
  @keyframes panelIn {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ===== Stage + Carousel ===== */
  .voice-stage {
    position: relative;
    height: 560px;
    perspective: 1800px;
    perspective-origin: 50% 50%;
    /* GPU合成 */
    transform: translateZ(0);
    -webkit-transform: translateZ(0);
  }

  .voice-carousel {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    -webkit-transform-style: preserve-3d;
    touch-action: pan-y;
    user-select: none;
    cursor: grab;
    /* GPU合成・カクつき防止 */
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .voice-carousel:active { cursor: grabbing; }

  /* ===== Swipe Arrows ===== */
  .voice-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: rgba(255, 255, 255, 0.85);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition:
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.18);
    -webkit-tap-highlight-color: transparent;
  }
  .voice-arrow svg {
    width: 22px;
    height: 22px;
  }
  .voice-arrow:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.45);
    box-shadow: 0 6px 22px rgba(0, 0, 0, 0.25), 0 0 16px rgba(255, 255, 255, 0.15);
    color: #fff;
  }
  .voice-arrow:active {
    transform: translateY(-50%) scale(0.92);
  }
  .voice-arrow--prev { left: 1rem; }
  .voice-arrow--next { right: 1rem; }

  /* スワイプヒント — 数秒で消える（静止表示） */
  .voice-swipe-hint {
    position: absolute;
    bottom: -8px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.32rem 0.95rem;
    border-radius: 100px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.6rem;
    letter-spacing: 0.22em;
    font-weight: 500;
    pointer-events: none;
    z-index: 10;
    opacity: 0.85;
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .voice-swipe-hint.is-hidden {
    opacity: 0;
    transform: translateX(-50%) translateY(8px);
  }
  .vsh-icon { display: inline-flex; }
  .vsh-icon svg { width: 22px; height: 16px; }

  /* ===== Card ===== */
  .voice-card {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 380px;
    transform: translate3d(-50%, -50%, -200px) scale(0.5) rotateY(0deg);
    opacity: 0;
    /* Aesop 級の静かで上品なイージング */
    transition:
      transform 0.85s cubic-bezier(0.22, 1, 0.36, 1),
      opacity   0.65s cubic-bezier(0.22, 1, 0.36, 1),
      filter    0.65s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform, opacity, filter;
    pointer-events: none;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transform-style: preserve-3d;
    -webkit-transform-style: preserve-3d;
  }

  /* 前面 — 大きく浮かび上がる（静止） */
  .voice-card.is-current {
    transform: translate3d(-50%, -50%, 0px) scale(1.04) rotateY(0deg);
    opacity: 1;
    z-index: 3;
    pointer-events: auto;
    filter: drop-shadow(0 50px 80px rgba(0,0,0,0.45));
  }

  /* 右 — 遠ざかる */
  .voice-card.is-next {
    transform: translate3d(18%, -50%, -180px) scale(0.55) rotateY(-22deg);
    opacity: 0.45;
    z-index: 2;
    filter: brightness(0.85);
    pointer-events: auto;
  }

  /* 左 — 遠ざかる */
  .voice-card.is-prev {
    transform: translate3d(-118%, -50%, -180px) scale(0.55) rotateY(22deg);
    opacity: 0.45;
    z-index: 2;
    filter: brightness(0.85);
    pointer-events: auto;
  }

  .voice-card.is-hidden {
    transform: translate3d(-50%, -50%, -300px) scale(0.4) rotateY(0deg);
    opacity: 0;
    z-index: 0;
    pointer-events: none;
  }

  /* ドラッグ中（一切のtransition/animationを切ってフレーム単位制御） */
  .voice-card.is-dragging {
    transition: none !important;
    animation: none !important;
  }
  /* 慣性復帰時のスプリングカーブ */
  .voice-card.is-springing {
    transition: transform 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) !important;
    animation: none !important;
  }

  .voice-card.no-anim {
    transition: none !important;
    animation: none !important;
  }

  /* ===== カード位置遷移のみ（3D回転なし・カード向き完全固定） ===== */
  .voice-carousel.drum-fwd,
  .voice-carousel.drum-bwd {
    transform-style: preserve-3d;
    -webkit-transform-style: preserve-3d;
  }
  /* RAFアニメ中はinline-styleで完全制御するので、is-rapidルールは不要
     （以前のis-rapid CSSは削除済み） */

  /* 着地（最終ステップ）：ゆっくり前面カードが大きくなる（spring風カーブ） */
  .voice-carousel.drum-fwd .voice-card,
  .voice-carousel.drum-bwd .voice-card {
    transition:
      transform 0.75s cubic-bezier(0.34, 1.12, 0.5, 1),
      opacity   0.6s cubic-bezier(0.22, 1, 0.36, 1),
      filter    0.6s cubic-bezier(0.22, 1, 0.36, 1) !important;
    animation: none !important;
    will-change: transform, opacity;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  /* 各カード自身もGPUレイヤを強制 */
  .voice-carousel.drum-fwd .voice-card,
  .voice-carousel.drum-bwd .voice-card,
  .voice-carousel.drum-fwd .card-face,
  .voice-carousel.drum-bwd .card-face {
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  /* 回転中は背景アニメも止めて GPU を回転に集中させる */
  .voice-section.is-spinning .vbg__leaf,
  .voice-section.is-spinning .voice-arrow {
    animation: none !important;
  }

  /* ===== Card Face（緑クリームガラス＋黄緑ネオン縁） ===== */
  .card-face {
    position: relative;
    background:
      linear-gradient(135deg,
        rgba(250, 255, 242, 0.24) 0%,
        rgba(248, 255, 238, 0.08) 45%,
        rgba(248, 255, 238, 0.16) 100%
      );
    backdrop-filter: blur(50px) saturate(200%);
    -webkit-backdrop-filter: blur(50px) saturate(200%);
    border-radius: 0.9rem;
    border: 1px solid rgba(184, 255, 26, 0.5);
    box-shadow:
      inset 0 1px 0 rgba(184, 255, 26, 0.45),
      inset 0 0 0 1px rgba(184, 255, 26, 0.08),
      inset 0 -1px 0 rgba(255, 255, 255, 0.06),
      0 0 24px rgba(184, 255, 26, 0.18),
      0 44px 88px -22px rgba(0, 0, 0, 0.6),
      0 24px 48px -14px rgba(0, 0, 0, 0.34);
    display: flex;
    flex-direction: column;
    min-height: 420px;
    overflow: hidden;
    isolation: isolate;
  }

  /* 表面の光沢ハイライト（上半分に光が走る） */
  .card-face::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 50%;
    background: linear-gradient(180deg,
      rgba(255, 255, 255, 0.18) 0%,
      rgba(255, 255, 255, 0.06) 50%,
      transparent 100%
    );
    pointer-events: none;
    border-radius: inherit;
    z-index: 0;
  }

  /* 右下に淡い色味の屈折（ガラスのレンズ感） */
  .card-face::after {
    content: '';
    position: absolute;
    bottom: -30%;
    right: -20%;
    width: 70%;
    height: 70%;
    background: radial-gradient(circle,
      rgba(184, 255, 26, 0.08) 0%,
      transparent 60%
    );
    pointer-events: none;
    border-radius: inherit;
    z-index: 0;
  }

  /* 内側コンテンツを表面光沢の上に */
  .card-face > .card-header,
  .card-face > .card-body-area {
    position: relative;
    z-index: 1;
  }

  /* ===== Card Header ===== */
  .card-header {
    padding: 2rem 2rem 0.4rem;
  }

  /* 年代ラベル（深緑ガラスバッジ） */
  .card-age {
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: #fff;
    padding: 0.35rem 0.95rem;
    background: rgba(27, 94, 58, 0.7);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 100px;
    display: inline-block;
  }

  /* 本文エリア */
  .card-body-area {
    padding: 1rem 2rem 2.1rem;
    flex: 1;
  }

  .card-deco {
    font-family: 'Cormorant Garamond', 'Noto Serif JP', Georgia, serif;
    font-size: 3.6rem;
    font-weight: 400;
    line-height: 0.6;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 0.2rem;
    user-select: none;
  }

  .card-quote {
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 1.32rem;
    font-weight: 700;
    line-height: 1.55;
    letter-spacing: 0.02em;
    color: #ffffff;
    margin-bottom: 1.1rem;
    text-shadow: 0 1px 4px rgba(0,0,0,0.32);
  }

  .card-body {
    font-size: 0.88rem;
    line-height: 1.95;
    color: rgba(255, 255, 255, 0.97);
    font-weight: 500;
    letter-spacing: 0.02em;
    text-shadow: 0 1px 3px rgba(0,0,0,0.22);
  }

  /* ===== Indicators ===== */
  .voice-indicators {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 1.2rem;
  }

  .voice-dot {
    position: relative;
    width: 7px; height: 7px;
    border-radius: 50%;
    border: none; padding: 0;
    background: rgba(255,255,255,0.35);
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.22,1,0.36,1);
  }
  /* 不可視の 44x44 タップ領域（WCAG 2.5.5 Target Size 準拠） */
  .voice-dot::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 44px;
    height: 44px;
  }
  .voice-dot.is-active {
    width: 28px;
    border-radius: 100px;
    background: #B8FF1A;
    box-shadow:
      0 0 14px rgba(184, 255, 26, 0.6),
      0 0 28px rgba(184, 255, 26, 0.22);
  }

  /* ===== Scroll Reveal ===== */
  [data-voice-anim] {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.7s cubic-bezier(0.22,1,0.36,1),
                transform 0.7s cubic-bezier(0.22,1,0.36,1);
  }
  [data-voice-anim].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ===== Responsive ===== */
  @media (max-width: 640px) {
    .voice-section { padding: 4.5rem 0 5rem; }
    .voice-container { padding: 0 1.2rem; }
    .voice-eyebrow { font-size: clamp(2.2rem, 10vw, 2.8rem); letter-spacing: 0.02em; }
    .voice-heading { font-size: 0.68rem; letter-spacing: 0.4em; margin-top: 1rem; padding-left: 0.4em; }
    .voice-header { margin-bottom: 1.8rem; }
    .voice-tabs { gap: 1.4rem; margin-bottom: 1.8rem; padding: 0.6rem 0; }
    .voice-tab { padding: 0.45rem 0; font-size: 0.74rem; letter-spacing: 0.12em; }
    .voice-stage { height: 460px; }
    .voice-card { width: 270px; }
    .card-face { min-height: 350px; }
    .card-header { padding: 1.5rem 1.5rem 0.4rem; }
    .card-body-area { padding: 0.7rem 1.5rem 1.6rem; }
    .card-deco { font-size: 2.8rem; }
    .card-quote { font-size: 1.08rem; line-height: 1.55; margin-bottom: 0.85rem; font-weight: 700; }
    .card-body { font-size: 0.82rem; line-height: 1.85; font-weight: 500; }
    .vbg__halo { width: 420px; height: 420px; filter: blur(60px); }
    .vbg__halo--tl { top: -220px; left: -200px; }
    .vbg__halo--br { bottom: -220px; right: -180px; }
  }

  /* ===== Reduced Motion 対応（WCAG 2.3.3 / 視覚的前庭障害への配慮） =====
     ユーザーが OS で「視差効果を減らす」設定をオンにしている場合、
     アニメーション・トランジションを実質無効化する */
  @media (prefers-reduced-motion: reduce) {
    /* 背景の光のシマー演出を停止 */
    .vbg__shine {
      animation: none !important;
    }

    /* スクロール連動のフェードアップを瞬時表示に */
    [data-voice-anim] {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }

    /* タブ切替・カードのトランジションを無効化 */
    .voice-tab,
    .voice-card,
    .voice-dot,
    .voice-arrow,
    .voice-swipe-hint {
      transition: none !important;
      animation: none !important;
    }

    /* カードのスライド・回転・スケール変化を停止
       （JS の RAF アニメは下部スクリプトで分岐） */
    .voice-card.is-prev,
    .voice-card.is-next,
    .voice-card.is-current,
    .voice-card.is-hidden {
      transition: none !important;
    }
  }
</style>

<script>
  function initVoice() {
    // 二重初期化を防ぐ（astro:page-load と直接呼び出しの両方で発火する場合に対応）
    const section = document.getElementById('voice');
    if (!section || (section as any)._vi) return;
    (section as any)._vi = true;

    const tabs   = document.querySelectorAll('.voice-tab')   as NodeListOf<HTMLElement>;
    const panels = document.querySelectorAll('.voice-panel') as NodeListOf<HTMLElement>;

    // OS 設定で「視差効果を減らす」が有効ならアニメ系の派手な動きを抑制
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ARIA 同期：タブ／パネルの選択状態を切り替える
    function activateTab(targetTab: HTMLElement) {
      const id = targetTab.dataset.tab;
      tabs.forEach(t => {
        const isActive = t === targetTab;
        t.classList.toggle('is-active', isActive);
        t.setAttribute('aria-selected', isActive ? 'true' : 'false');
        t.setAttribute('tabindex', isActive ? '0' : '-1');
      });
      panels.forEach(p => {
        const isActive = p.dataset.panel === id;
        p.classList.toggle('is-active', isActive);
        p.toggleAttribute('hidden', !isActive);
        p.setAttribute('tabindex', isActive ? '0' : '-1');
        if (isActive) initCarousel(p);
      });
    }

    // タブクリック＋キーボード操作（左右矢印・Home・End）
    tabs.forEach((tab, idx) => {
      tab.addEventListener('click', () => activateTab(tab));
      tab.addEventListener('keydown', (e: KeyboardEvent) => {
        let nextIdx = -1;
        if (e.key === 'ArrowRight') nextIdx = (idx + 1) % tabs.length;
        else if (e.key === 'ArrowLeft') nextIdx = (idx - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') nextIdx = 0;
        else if (e.key === 'End') nextIdx = tabs.length - 1;
        if (nextIdx >= 0) {
          e.preventDefault();
          activateTab(tabs[nextIdx]);
          tabs[nextIdx].focus();
        }
      });
    });

    panels.forEach(p => { if (p.classList.contains('is-active')) initCarousel(p); });

    function initCarousel(panel: HTMLElement) {
      // 前回のクリーンアップを実行（累積イベント防止）
      if ((panel as any)._vc_cleanup) (panel as any)._vc_cleanup();

      const cards = panel.querySelectorAll('.voice-card') as NodeListOf<HTMLElement>;
      const dots  = panel.querySelectorAll('.voice-dot')  as NodeListOf<HTMLElement>;
      const car   = panel.querySelector('.voice-carousel') as HTMLElement;
      const total = cards.length;
      let current = 0;
      let isDragging = false;
      let startX = 0;
      let dx = 0;

      function update() {
        cards.forEach((card, i) => {
          card.classList.remove('is-current','is-next','is-prev','is-hidden','no-anim');
          if      (i === current)                       card.classList.add('is-current');
          else if (i === (current + 1) % total)         card.classList.add('is-next');
          else if (i === (current - 1 + total) % total) card.classList.add('is-prev');
          else                                          card.classList.add('is-hidden');
          // ARIA 同期：現在のカードのみ読み上げ可能、それ以外は隠す
          card.setAttribute('aria-hidden', i === current ? 'false' : 'true');
        });
        dots.forEach((d, i) => {
          const isActive = i === current;
          d.classList.toggle('is-active', isActive);
          d.setAttribute('aria-selected', isActive ? 'true' : 'false');
          d.setAttribute('tabindex', isActive ? '0' : '-1');
        });
      }

      // 真円軌道アニメ：requestAnimationFrame で各カードの位置を毎フレーム計算
      // → 等間隔・ブレなし・スワイプ後の詰まりなし
      let isSpinning = false;
      const voiceSection = document.getElementById('voice');

      // 角度→位置スタイルへの変換
      // 静的CSS（is-current/is-prev/is-next）と完全一致するよう係数を逆算
      // → 0°/±120° のとき静的位置とピッタリ重なる → スタート時の「スナップ」を排除
      function styleAt(angle: number) {
        const rad = (angle * Math.PI) / 180;
        const sin = Math.sin(rad);
        const cos = Math.cos(rad);
        const depth = (cos + 1) / 2; // 1(前) → 0.25(±120°) → 0(背面)

        // 静的値: 角度0°でscale 1.04/op 1.0、角度±120°でscale 0.55/op 0.45 をぴったり実現
        const x = sin * 280;                      // 余白拡大によるカード幅調整
        const z = (cos - 1) * 120;                // angle ±120° で -180px (静的と一致)
        const scale = 0.387 + depth * 0.653;       // 0° → 1.04、±120° → 0.55
        const opacity = 0.267 + depth * 0.733;     // 0° → 1.0、±120° → 0.45
        const brightness = 0.85 + depth * 0.15;    // 0° → 1.0、±120° → 0.85

        return { x, z, scale, opacity, brightness };
      }

      // ドラッグ状態を引き継ぐためのオフセット型
      type DragOffset = { dx: number; tY: number; sclDelta: number; rot: number };

      function drumTo(newIndex: number, dir: number, dragOffset?: DragOffset) {
        if (isSpinning) return;
        isSpinning = true;

        // ドラッグ状態のクラスを除去（inline-styleはRAFが上書き）
        cards.forEach(c => {
          c.classList.remove('is-dragging', 'is-springing');
        });

        // 視差効果軽減モード：回転アニメをスキップして即座にスナップ
        if (prefersReducedMotion) {
          // RAF が書き込んだ inline style を解除して、is-current/is-prev/is-next の静的CSSに戻す
          cards.forEach(c => { (c as HTMLElement).style.cssText = ''; });
          current = newIndex;
          update();
          isSpinning = false;
          voiceSection?.classList.remove('is-spinning');
          return;
        }

        car.classList.add(dir >= 0 ? 'drum-fwd' : 'drum-bwd');
        voiceSection?.classList.add('is-spinning');

        // 開始時の各カードの角度（current=0°, next=+120°, prev=-120°）
        const startAngles = Array.from(cards).map((_, i) => {
          const offset = ((i - current + total) % total);
          return offset === 0 ? 0 : offset === 1 ? 120 : -120;
        });

        // 9周分の回転 + advance調整
        const advance = ((newIndex - current) * dir + total) % total;
        const totalDelta = -dir * (360 * 9 + 120 * advance);

        const startTime = performance.now();
        const DURATION = 1300;
        const DRAG_DECAY_MS = 120; // ドラッグオフセットを高速に解消

        function frame() {
          const elapsed = performance.now() - startTime;
          const t = Math.min(elapsed / DURATION, 1);

          // シンプルな ease-out：開始直後から動き始め、徐々に減速して着地
          // 「止まってから回る」感を完全排除
          const eased = 1 - Math.pow(1 - t, 2.4);

          const sysAngle = eased * totalDelta;

          // ドラッグオフセットの減衰係数（1→0、最初の120msで素早く解消）
          const decay = dragOffset
            ? Math.max(0, 1 - elapsed / DRAG_DECAY_MS)
            : 0;
          // ease-out カーブで自然に減衰
          const easeDecay = decay > 0 ? 1 - Math.pow(1 - decay, 2) : 0;

          cards.forEach((card, i) => {
            const a = startAngles[i] + sysAngle;
            const { x, z, scale, opacity, brightness } = styleAt(a);
            const el = card as HTMLElement;

            // ドラッグされていたカード（startAngle=0）にだけドラッグオフセットを適用
            let extraX = 0, extraY = 0, extraScl = 0, extraRot = 0;
            if (dragOffset && startAngles[i] === 0) {
              extraX = dragOffset.dx * easeDecay;
              extraY = dragOffset.tY * easeDecay;
              extraScl = dragOffset.sclDelta * easeDecay;
              extraRot = dragOffset.rot * easeDecay;
            }

            const finalScale = scale + extraScl;
            el.style.transition = 'none';
            el.style.transform = `translate3d(calc(-50% + ${x + extraX}px), calc(-50% + ${extraY}px), ${z}px) scale(${finalScale}) rotateY(${extraRot}deg)`;
            el.style.opacity = String(opacity);
            el.style.filter = `brightness(${brightness})`;
            el.style.willChange = 'transform, opacity, filter';
          });

          if (t < 1) {
            requestAnimationFrame(frame);
          } else {
            // クリーンアップ：inline-styleを外して通常のクラスベース表示に戻す
            cards.forEach(c => {
              const el = c as HTMLElement;
              el.style.transition = '';
              el.style.transform = '';
              el.style.opacity = '';
              el.style.filter = '';
              el.style.willChange = '';
            });
            current = newIndex;
            update();
            car.classList.remove('drum-fwd', 'drum-bwd');
            voiceSection?.classList.remove('is-spinning');
            isSpinning = false;
          }
        }

        requestAnimationFrame(frame);
      }

      // ドットクリック（クリーンアップ対象）
      const dotHandlers: Array<{el: HTMLElement, fn: () => void}> = [];
      dots.forEach((d, i) => {
        const fn = () => {
          const dir = i > current ? 1 : -1;
          drumTo(i, dir);
        };
        d.addEventListener('click', fn);
        dotHandlers.push({ el: d, fn });
      });

      // 矢印ボタン（クリーンアップ対象）
      const arrowHandlers: Array<{el: HTMLElement, fn: (e: Event) => void}> = [];
      const stage = panel.querySelector('.voice-stage') as HTMLElement;
      const arrowPrev = stage?.querySelector('[data-arrow="prev"]') as HTMLElement | null;
      const arrowNext = stage?.querySelector('[data-arrow="next"]') as HTMLElement | null;
      if (arrowPrev) {
        const fn = (e: Event) => {
          e.preventDefault();
          e.stopPropagation();
          drumTo((current - 1 + total) % total, -1);
          // スワイプヒントを消す
          const hint = stage?.querySelector('.voice-swipe-hint') as HTMLElement;
          if (hint) hint.classList.add('is-hidden');
        };
        arrowPrev.addEventListener('click', fn);
        arrowHandlers.push({ el: arrowPrev, fn });
      }
      if (arrowNext) {
        const fn = (e: Event) => {
          e.preventDefault();
          e.stopPropagation();
          drumTo((current + 1) % total, 1);
          const hint = stage?.querySelector('.voice-swipe-hint') as HTMLElement;
          if (hint) hint.classList.add('is-hidden');
        };
        arrowNext.addEventListener('click', fn);
        arrowHandlers.push({ el: arrowNext, fn });
      }

      // カードクリック（クリーンアップ対象）
      const cardHandlers: Array<{el: HTMLElement, fn: () => void}> = [];
      cards.forEach((card) => {
        const fn = () => {
          if (Math.abs(dx) > 8) return;
          if (card.classList.contains('is-next')) drumTo((current+1)%total, 1);
          else if (card.classList.contains('is-prev')) drumTo((current-1+total)%total, -1);
        };
        card.addEventListener('click', fn);
        cardHandlers.push({ el: card, fn });
      });

      // ===== Drag / Swipe（速度追跡＋慣性付き） =====
      let lastX = 0;
      let lastT = 0;
      let velocity = 0; // px/ms
      let rafId: number | null = null;
      let pendingX: number | null = null;

      function dragStart(x: number) {
        isDragging = true;
        startX = x;
        dx = 0;
        lastX = x;
        lastT = performance.now();
        velocity = 0;
        // 関連するすべてのカードに dragging を適用（スムーズな部分追従用）
        cards.forEach(c => {
          c.classList.add('is-dragging');
          c.classList.remove('is-springing');
        });
        const ac = car.querySelector('.is-current') as HTMLElement;
        if (ac) ac.style.willChange = 'transform';
      }

      function applyDragFrame() {
        rafId = null;
        if (!isDragging || pendingX === null) return;
        const x = pendingX;
        pendingX = null;

        const now = performance.now();
        const elapsed = Math.max(1, now - lastT);
        velocity = (x - lastX) / elapsed; // px/ms
        lastX = x;
        lastT = now;
        dx = x - startX;

        const absDx = Math.abs(dx);

        // 抵抗（drag-resistance）— 大きく動くほど鈍くする
        const resistDx = dx * (1 - Math.min(absDx / 800, 0.3));

        const ac = car.querySelector('.is-current') as HTMLElement;
        if (ac) {
          const rot = resistDx * -0.022;
          const scl = Math.max(1.04 - absDx * 0.00035, 0.95);
          const tY = absDx * 0.025;
          ac.style.transform = `translate3d(calc(-50% + ${resistDx}px), calc(-50% + ${tY}px), 0) scale(${scl}) rotateY(${rot}deg)`;
        }

        // ドラッグ中、隣のカードもわずかに反応させる（プレビュー感）
        const next = car.querySelector('.is-next') as HTMLElement;
        const prev = car.querySelector('.is-prev') as HTMLElement;
        const peekShift = Math.max(-1, Math.min(1, dx / 200)); // -1..1
        if (next) {
          // dxが負（左にドラッグ） → next が前に出る
          const peek = -peekShift; // 0..1 に
          const opa = 0.45 + Math.max(0, peek) * 0.45;
          next.style.transform = `translate3d(calc(18% - ${peek * 80}px), -50%, ${-180 + peek * 100}px) scale(${0.55 + peek * 0.15}) rotateY(${-22 + peek * 12}deg)`;
          next.style.opacity = String(opa);
        }
        if (prev) {
          const peek = peekShift; // -1..1
          const opa = 0.45 + Math.max(0, peek) * 0.45;
          prev.style.transform = `translate3d(calc(-118% + ${peek * 80}px), -50%, ${-180 + peek * 100}px) scale(${0.55 + peek * 0.15}) rotateY(${22 - peek * 12}deg)`;
          prev.style.opacity = String(opa);
        }
      }

      function dragMove(x: number) {
        if (!isDragging) return;
        pendingX = x;
        if (rafId === null) rafId = requestAnimationFrame(applyDragFrame);
      }

      function clearInlineStyles() {
        cards.forEach(c => {
          c.classList.remove('is-dragging', 'is-springing');
          c.style.transform = '';
          c.style.opacity = '';
          c.style.willChange = '';
        });
      }

      function dragEnd() {
        if (!isDragging) return;
        isDragging = false;
        if (rafId !== null) { cancelAnimationFrame(rafId); rafId = null; }
        pendingX = null;

        const absDx = Math.abs(dx);
        const absV = Math.abs(velocity); // px/ms

        // 慣性しきい値: 距離 > 55px か 速度 > 0.5 px/ms（≒ flick）
        const shouldAdvance = absDx > 55 || absV > 0.5;

        if (shouldAdvance) {
          const dir = dx < 0 ? 1 : -1;
          // ドラッグの現在位置を捕捉してdrumToへ引き継ぐ
          // → 回転中に滑らかに減衰して0に近づき、スワイプから自然に回転へ移行
          const absDx = Math.abs(dx);
          const dragOffset = {
            dx: dx,
            tY: absDx * 0.025,
            sclDelta: Math.max(1.04 - absDx * 0.00035, 0.95) - 1.04, // 現在のscale - 1.04
            rot: dx * -0.022,
          };
          drumTo((current + dir + total) % total, dir, dragOffset);
        } else {
          // キャンセル: スプリングで元位置に戻す
          cards.forEach(c => {
            c.classList.remove('is-dragging');
            c.classList.add('is-springing');
            c.style.transform = '';
            c.style.opacity = '';
          });
          // springing クラスを 600ms 後に外す
          setTimeout(() => {
            cards.forEach(c => c.classList.remove('is-springing'));
          }, 600);
        }

        dx = 0;
        velocity = 0;
      }

      // Touch
      const onTS = (e: TouchEvent) => dragStart(e.touches[0].clientX);
      const onTM = (e: TouchEvent) => dragMove(e.touches[0].clientX);
      const onTE = () => dragEnd();
      car.addEventListener('touchstart', onTS as EventListener, { passive: true });
      car.addEventListener('touchmove',  onTM as EventListener, { passive: true });
      car.addEventListener('touchend',   onTE, { passive: true });

      // PC Mouse drag
      const onMD = (e: MouseEvent) => { e.preventDefault(); dragStart(e.clientX); };
      const onMM = (e: MouseEvent) => { if (isDragging) dragMove(e.clientX); };
      const onMU = () => { if (isDragging) dragEnd(); };
      const onDS = (e: Event) => e.preventDefault();
      const onSS = (e: Event) => { if (isDragging) e.preventDefault(); };
      car.addEventListener('mousedown', onMD as EventListener);
      car.addEventListener('dragstart', onDS);
      document.addEventListener('mousemove',   onMM as EventListener);
      document.addEventListener('mouseup',     onMU);
      document.addEventListener('selectstart', onSS);

      // クリーンアップ登録（全リスナーを確実に解除）
      (panel as any)._vc_cleanup = () => {
        dotHandlers.forEach(({ el, fn }) => el.removeEventListener('click', fn));
        cardHandlers.forEach(({ el, fn }) => el.removeEventListener('click', fn));
        arrowHandlers.forEach(({ el, fn }) => el.removeEventListener('click', fn));
        car.removeEventListener('touchstart', onTS as EventListener);
        car.removeEventListener('touchmove',  onTM as EventListener);
        car.removeEventListener('touchend',   onTE);
        car.removeEventListener('mousedown',  onMD as EventListener);
        car.removeEventListener('dragstart',  onDS);
        document.removeEventListener('mousemove',   onMM as EventListener);
        document.removeEventListener('mouseup',     onMU);
        document.removeEventListener('selectstart', onSS);
      };

      update();
    }

    // Scroll reveal
    const obs = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('is-visible'); });
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('[data-voice-anim]').forEach(el => obs.observe(el));
  }

  // astro:page-load は初回ロード・View Transitions 両方で発火
  // _vi フラグで二重実行を防止しているため直接呼び出しも安全
  document.addEventListener('astro:page-load', () => {
    const s = document.getElementById('voice');
    if (s) delete (s as any)._vi; // ページ遷移時はフラグリセット
    initVoice();
  });
  initVoice();
</script>
