---
// News Component
import { getNewsList } from '../lib/microcms';

// MicroCMSからニュースを取得（エラー時はフォールバックデータを使用）
const newsItems = await getNewsList(10);

// カテゴリごとのラベル色とボーダー色を定義
const getCategoryStyle = (category: string) => {
  switch (category) {
    case 'メディア掲載':
    case 'UPDATE':
      return { badge: 'bg-[#D4FF00] text-[#231815]', border: 'border-l-[#D4FF00]' };
    default:
      return { badge: 'bg-[#2e7d32] text-white', border: 'border-l-[#2e7d32]' };
  }
};
---

<section data-section-theme="dark" id="news" class="py-10 relative overflow-hidden">
  <!-- 深い緑がかったダーク背景 -->
  <div class="absolute inset-0 bg-gradient-to-br from-[#1a2218] via-[#1e2a1c] to-[#192017]"></div>
  <!-- 微かなノイズテクスチャ -->
  <div class="absolute inset-0 opacity-[0.03]" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 256 256%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noise%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noise)%22/%3E%3C/svg%3E');"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">
    <div class="flex flex-col md:flex-row items-start md:items-center gap-6 md:gap-10">
      <!-- Title -->
      <div class="flex items-center flex-shrink-0">
        <h2 class="text-2xl font-bold text-white/90 tracking-wider mr-4"><span class="font-maru">NEWS</span></h2>
        <span class="text-xs text-white/40">お知らせ</span>
      </div>

      <!-- News Cards -->
      <div class="flex-grow w-full space-y-2">
        {newsItems.map((item, index) => {
          const style = getCategoryStyle(item.category);
          return (
            <a
              href={item.link || "#"}
              class={`news-card group flex items-center justify-between gap-4 border-l-3 ${style.border} rounded-r-lg px-4 py-3 transition-all duration-300 hover:translate-x-1 hover:border-l-[#D4FF00] focus:outline-none`}
              aria-label={`${item.title}の詳細を見る`}
            >
              <div class="flex items-center gap-3 min-w-0">
                <time class="text-xs text-white/30 font-mono whitespace-nowrap flex-shrink-0">{item.date}</time>
                <span class={`text-[10px] font-bold px-2.5 py-0.5 rounded-full whitespace-nowrap flex-shrink-0 ${style.badge}`}>
                  {item.category}
                </span>
                <span class="text-sm font-bold text-white/80 group-hover:text-white transition-colors truncate">
                  {item.title}
                </span>
              </div>
              <svg
                class="flex-shrink-0 text-white/15 group-hover:text-[#D4FF00] transition-all duration-300 group-hover:translate-x-1"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          );
        })}
      </div>

      <!-- View All -->
      <div class="hidden md:flex items-center flex-shrink-0">
        <a
          href="#"
          class="text-xs font-bold text-white/40 hover:text-[#D4FF00] flex items-center group whitespace-nowrap transition-colors focus:outline-none rounded px-2 py-1"
          aria-label="すべてのニュースを見る"
        >
          VIEW ALL
          <svg
            class="ml-2 transition-transform group-hover:translate-x-1"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>

      <!-- View All (Mobile) -->
      <div class="md:hidden w-full text-right">
        <a
          href="#"
          class="text-xs font-bold text-white/40 hover:text-[#D4FF00] transition-colors focus:outline-none rounded px-2 py-1"
          aria-label="すべてのニュースを見る"
        >
          VIEW ALL →
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .news-card {
    border-left-width: 3px;
    background: rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: 1px solid rgba(255, 255, 255, 0.04);
    border-right: 1px solid rgba(255, 255, 255, 0.02);
    border-bottom: 1px solid rgba(255, 255, 255, 0.02);
  }
  .news-card:hover {
    background: rgba(255, 255, 255, 0.08);
    box-shadow: 0 4px 20px rgba(46, 125, 50, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }
</style>
