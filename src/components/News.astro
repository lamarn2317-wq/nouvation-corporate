---
// News Component
import { getNewsList } from '../lib/microcms';

// MicroCMSからニュースを取得（エラー時はフォールバックデータを使用）
const newsItems = await getNewsList(10);

// カテゴリごとのラベル色を定義
const getCategoryStyle = (category: string) => {
  switch (category) {
    case 'メディア掲載':
    case 'UPDATE':
      return 'bg-[#D4FF00] text-[#231815]';
    default:
      return 'bg-[#2e7d32] text-white';
  }
};
---

<section data-section-theme="light" id="news" class="py-12 bg-[#F6F6EE] border-y border-gray-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col md:flex-row items-start md:items-center gap-6 md:gap-12">
      <!-- Title -->
      <div class="flex items-center flex-shrink-0">
        <h2 class="text-2xl font-bold text-[#231815] tracking-wider mr-4"><span class="font-maru">NEWS</span></h2>
        <span class="text-xs text-[#231815]/70">お知らせ</span>
      </div>

      <!-- News List -->
      <div class="flex-grow w-full">
        <ul class="space-y-3">
          {newsItems.map((item) => (
            <li>
              <a
                href={item.link || "#"}
                class="flex items-center gap-4 p-4 border border-[#231815]/10 rounded-xl hover:bg-white transition-colors group focus:outline-none"
                aria-label={`${item.title}の詳細を見る`}
              >
                <time class="text-sm text-[#231815]/50 font-mono whitespace-nowrap flex-shrink-0">{item.date}</time>
                <span class={`text-[10px] font-bold px-3 py-1 rounded-full whitespace-nowrap flex-shrink-0 ${getCategoryStyle(item.category)}`}>
                  {item.category}
                </span>
                <span class="text-sm font-bold text-[#231815] group-hover:text-[#2e7d32] transition-colors truncate">
                  {item.title}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- View All Link (PC) -->
      <div class="hidden md:flex items-center flex-shrink-0">
        <a
          href="#"
          class="text-xs font-bold text-[#231815] hover:text-[#2e7d32] flex items-center group whitespace-nowrap transition-colors focus:outline-none rounded px-2 py-1"
          aria-label="すべてのニュースを見る"
        >
          VIEW ALL
          <svg
            class="ml-2 transition-transform group-hover:translate-x-1"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>

      <!-- View All Link (Mobile) -->
      <div class="md:hidden w-full text-right">
        <a
          href="#"
          class="text-xs font-bold text-[#231815] hover:text-[#2e7d32] transition-colors focus:outline-none rounded px-2 py-1"
          aria-label="すべてのニュースを見る"
        >
          VIEW ALL →
        </a>
      </div>
    </div>
  </div>
</section>
