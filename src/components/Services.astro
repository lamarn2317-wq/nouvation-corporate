    border: 1px solid rgba(46, 125, 50, 0.12);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.8) inset,
      0 1px 2px rgba(35, 24, 21, 0.02),
      0 8px 20px -6px rgba(46, 125, 50, 0.08),
      0 24px 48px -12px rgba(35, 24, 21, 0.08);
  }
  /* 上部にアグリグリーン→ライム→アグリグリーンのアクセントバー */
  .market-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
