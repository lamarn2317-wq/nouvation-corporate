    inset: -2px;
    border-radius: 50%;
    background: rgba(46, 125, 50, 0.45);
    animation: market-pulse 2s ease-out infinite 0.5s;
  }
  /* チャート背景：薄いグリッドパターン（計測パネル感） */
  .market-card__chart-wrap {
    background:
      linear-gradient(to right,
        rgba(46, 125, 50, 0.025) 1px,
        transparent 1px) 0 0 / 40px 40px,
      linear-gradient(to bottom,
        rgba(46, 125, 50, 0.025) 1px,
        transparent 1px) 0 0 / 40px 40px,
      linear-gradient(180deg,
        rgba(246, 246, 238, 0.4) 0%,
        rgba(255, 255, 255, 0) 100%);
  }
  @media (prefers-reduced-motion: reduce) {
    .market-card__live-dot::after {
