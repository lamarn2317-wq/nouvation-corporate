<script>
  import Chart from 'chart.js/auto';
  import 'chartjs-adapter-luxon';

  interface MarketPrice {
    date: string;
    item: string;
    market: string;
    price: number;
    unit: string;
  }

  async function initChart() {
    const container = document.getElementById('market-data-container');
    if (!container) return;

    // データの読み込み（SSG: 埋め込まれたデータを即座に取得）
    let prices: MarketPrice[] = [];
    try {
      prices = JSON.parse(container.dataset.prices || '[]');
    } catch (e) {
      console.error("Data Load Error:", e);
      return;
    }

    console.log("Market Prices Data Count:", prices.length);

    // ローディングを即座に非表示にする
    const loader = document.getElementById('chartLoader');
    if (loader) {
      loader.style.display = 'none';
    }

    const canvas = document.getElementById('marketChart') as HTMLCanvasElement;
    const itemFilter = document.getElementById('itemFilter') as HTMLSelectElement;
    const marketFilter = document.getElementById('marketFilter') as HTMLSelectElement;

    if (!canvas || !itemFilter || !marketFilter || prices.length === 0) {
      console.warn("Required elements or data missing", { canvas, itemFilter, marketFilter, dataCount: prices.length });
      return;
    }

    // 既存の選択肢をクリア
    itemFilter.innerHTML = '';
    marketFilter.innerHTML = '';

    // フィルターの選択肢を生成
    const items = [...new Set(prices.map(p => p.item))].filter(Boolean).sort();
    const markets = [...new Set(prices.map(p => p.market))].filter(Boolean).sort();

    items.forEach(item => {
      const opt = document.createElement('option');
      opt.value = item;
      opt.textContent = item;
      itemFilter.appendChild(opt);
    });

    markets.forEach(market => {
      const opt = document.createElement('option');
      opt.value = market;
      opt.textContent = market;
      marketFilter.appendChild(opt);
    });

    let chart: Chart | null = null;

    // --- KPIカード更新ロジック ---
    // 直近価格・前日比・週レンジ・サマリーをデータから計算してDOMへ反映
    function updateKpiCards(seriesData: MarketPrice[], itemName: string, marketName: string) {
      const elCurrent      = document.getElementById('kpiCurrent');
      const elCurrentDate  = document.getElementById('kpiCurrentDate');
      const elChange       = document.getElementById('kpiChange');
      const elChangeRate   = document.getElementById('kpiChangeRate');
      const elRange        = document.getElementById('kpiRange');
      const elRangeSpread  = document.getElementById('kpiRangeSpread');
      const elSummary      = document.getElementById('kpiSummary');

      // データが空の場合は全カードを「—」表示にリセット
      if (!seriesData.length) {
        [elCurrent, elChange, elRange].forEach(el => { if (el) el.textContent = '—'; });
        [elCurrentDate, elChangeRate, elRangeSpread].forEach(el => { if (el) el.textContent = '—'; });
        if (elSummary) elSummary.textContent = 'データなし';
        // 色のリセット
        elChange?.classList.remove('kpi-card__value--up', 'kpi-card__value--down', 'kpi-card__value--flat');
        return;
      }

      const latest   = seriesData[seriesData.length - 1];
      const previous = seriesData.length > 1 ? seriesData[seriesData.length - 2] : null;
      const allPrices = seriesData.map(p => p.price);
      const highest   = Math.max(...allPrices);
      const lowest    = Math.min(...allPrices);
      const average   = allPrices.reduce((a, b) => a + b, 0) / allPrices.length;

      // CURRENT
      if (elCurrent) elCurrent.textContent = `¥${latest.price.toLocaleString()}`;
      if (elCurrentDate) {
        const d = new Date(latest.date);
        elCurrentDate.textContent = `${d.getMonth() + 1}/${d.getDate()} 時点`;
      }

      // DAY CHANGE
      if (elChange && elChangeRate) {
        elChange.classList.remove('kpi-card__value--up', 'kpi-card__value--down', 'kpi-card__value--flat');
        if (previous) {
          const delta = latest.price - previous.price;
          const rate  = previous.price !== 0 ? (delta / previous.price) * 100 : 0;
          const sign  = delta > 0 ? '+' : (delta < 0 ? '−' : '±');
          const abs   = Math.abs(delta).toLocaleString();
          elChange.textContent = `${sign}¥${abs}`;
          elChangeRate.textContent = `${delta >= 0 ? '+' : '−'}${Math.abs(rate).toFixed(1)}%`;
          if (delta > 0) elChange.classList.add('kpi-card__value--up');
          else if (delta < 0) elChange.classList.add('kpi-card__value--down');
          else elChange.classList.add('kpi-card__value--flat');
        } else {
          elChange.textContent = '—';
          elChangeRate.textContent = '前日データなし';
          elChange.classList.add('kpi-card__value--flat');
        }
      }

      // WEEK RANGE
      if (elRange) elRange.textContent = `¥${lowest.toLocaleString()}–¥${highest.toLocaleString()}`;
      if (elRangeSpread) {
        const spread = highest - lowest;
        const spreadRate = average !== 0 ? (spread / average) * 100 : 0;
        elRangeSpread.textContent = `振れ幅 ${spreadRate.toFixed(1)}%`;
      }

      // MARKET INSIGHT（自動要約）
      if (elSummary) {
        const vsAvg = latest.price - average;
        const vsAvgRate = average !== 0 ? (vsAvg / average) * 100 : 0;
        const trend = vsAvg > 0
          ? `週平均比 +${vsAvgRate.toFixed(1)}% の上振れ`
          : vsAvg < 0
            ? `週平均比 ${vsAvgRate.toFixed(1)}% の下振れ`
            : '週平均と同水準';
        elSummary.textContent = `${marketName}の${itemName}：${trend}`;
      }
    }

    function updateChart() {
      const selectedItem = itemFilter.value;
      const selectedMarket = marketFilter.value;

      let filtered = prices.filter(p => 
        p.item === selectedItem && p.market === selectedMarket
      );

      // 日付順にソート
      filtered.sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime());

      // 表示基準日：データ内の最新日（データ更新が止まっていても直近データを表示）
      const latestEntry = filtered[filtered.length - 1];
      const now = new Date();
      const baseDay = latestEntry
        ? new Date(latestEntry.date)
        : new Date(now.getFullYear(), now.getMonth(), now.getDate());
      const today = new Date(baseDay.getFullYear(), baseDay.getMonth(), baseDay.getDate());
      const oneWeekAgo = new Date(today);
      oneWeekAgo.setDate(today.getDate() - 7);

      // データの絞り込み（基準日から7日前まで）
      filtered = filtered.filter(p => {
        const d = new Date(p.date);
        return d >= oneWeekAgo && d <= today;
      });

      // --- KPI カードの更新 ---
      updateKpiCards(filtered, selectedItem, selectedMarket);

      if (chart) {
        chart.destroy();
      }

      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      // --- 主要メトリクス計算（Chart演出に使用）---
      const allPrices  = filtered.map(p => p.price);
      const seriesAvg  = allPrices.length
        ? allPrices.reduce((a, b) => a + b, 0) / allPrices.length
        : 0;
      const seriesHigh = allPrices.length ? Math.max(...allPrices) : 0;
      const seriesLow  = allPrices.length ? Math.min(...allPrices) : 0;
      const isMobile   = window.matchMedia('(max-width: 767px)').matches;

      // --- 縦方向グラデーション：上=アグリグリーン濃、中=ライム、下=透明 ---
      const canvasHeight = canvas.height || (isMobile ? 300 : 400);
      const gradient = ctx.createLinearGradient(0, 0, 0, canvasHeight);
      gradient.addColorStop(0,    'rgba(46, 125, 50, 0.28)');
      gradient.addColorStop(0.45, 'rgba(212, 255, 0, 0.18)');
      gradient.addColorStop(1,    'rgba(246, 246, 238, 0)');

      // --- ポイントカラー：最高値=ライム、最安値=濃緑、それ以外=透明 ---
      const pointBgColors = filtered.map(p => {
        if (p.price === seriesHigh) return '#D4FF00';   // 最高値: ライム
        if (p.price === seriesLow)  return '#1B5E20';   // 最安値: 濃緑
        return 'rgba(46, 125, 50, 0.55)';                // 通常: 半透明緑
      });
      const pointBorderColors = filtered.map(p => {
        if (p.price === seriesHigh) return '#2e7d32';
        if (p.price === seriesLow)  return '#ffffff';
        return '#ffffff';
      });
      const pointRadii = filtered.map(p => {
        if (p.price === seriesHigh || p.price === seriesLow) return isMobile ? 5 : 6;
        return isMobile ? 0 : 3;
      });
      const pointBorderWidths = filtered.map(p => {
        if (p.price === seriesHigh || p.price === seriesLow) return 2.5;
        return 1.5;
      });

      chart = new Chart(ctx, {
        type: 'line',
        data: {
          datasets: [
            {
              label: '価格推移',
              data: filtered.map(p => ({ x: new Date(p.date).getTime(), y: p.price })),
              borderColor: '#2e7d32',
              backgroundColor: gradient,
              borderWidth: 2.5,
              fill: true,
              tension: 0.32,
              pointRadius: pointRadii,
              pointHoverRadius: 8,
              pointBackgroundColor: pointBgColors,
              pointBorderColor: pointBorderColors,
              pointBorderWidth: pointBorderWidths,
              pointHoverBorderWidth: 3,
              spanGaps: true,
              order: 1,
            },
            {
              label: '週平均',
              data: allPrices.length
                ? filtered.map(p => ({ x: new Date(p.date).getTime(), y: seriesAvg }))
                : [],
              borderColor: 'rgba(17, 17, 17, 0.28)',
              borderDash: [5, 5],
              borderWidth: 1.25,
              pointRadius: 0,
              pointHoverRadius: 0,
              fill: false,
              tension: 0,
              order: 2,
            }
          ]
        } as any,
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: { intersect: false, mode: 'index' },
          animation: {
            duration: 1000,
            easing: 'easeOutQuart',
          },
          plugins: {
            legend: {
              display: !isMobile,
              position: 'top',
              align: 'end',
              labels: {
                usePointStyle: true,
                boxWidth: 8,
                boxHeight: 8,
                color: 'rgba(35, 24, 21, 0.6)',
                font: { family: "'Noto Sans JP', sans-serif", size: 11, weight: 600 },
                padding: 12,
                filter: (item: any) => item.text !== '価格推移',
              }
            },
            tooltip: {
              backgroundColor: '#111111',
              titleColor: '#D4FF00',
              bodyColor: '#F6F6EE',
              padding: 14,
              cornerRadius: 12,
              displayColors: false,
              titleFont: { family: "'Noto Sans JP', sans-serif", size: 12, weight: 700 },
              bodyFont: { family: 'ui-monospace, SF Mono, monospace', size: 13, weight: 600 },
              borderColor: 'rgba(212, 255, 0, 0.2)',
              borderWidth: 1,
              callbacks: {
                title: (tooltipItems: any) => {
                  const item = tooltipItems[0];
                  const d = new Date(item.parsed.x);
                  return `${d.getMonth() + 1}月${d.getDate()}日`;
                },
                label: (context: any) => {
                  const v = context.parsed.y;
                  const isAvg = context.datasetIndex === 1;
                  if (isAvg) return `  週平均  ¥${v.toLocaleString()}`;
                  const diff = v - seriesAvg;
                  const pct  = seriesAvg !== 0 ? (diff / seriesAvg) * 100 : 0;
                  const sign = diff >= 0 ? '+' : '−';
                  const tag  = v === seriesHigh ? ' ★最高' : v === seriesLow ? ' ☆最安' : '';
                  return [
                    `  価格  ¥${v.toLocaleString()}/kg${tag}`,
                    `  平均比 ${sign}${Math.abs(pct).toFixed(1)}%`,
                  ];
                }
              }
            }
          },
          scales: {
            x: {
              type: 'time',
              time: { unit: 'day', displayFormats: { day: 'M/d' } },
              min: oneWeekAgo.getTime(),
              max: today.getTime(),
              grid: { display: false },
              border: { display: false },
              ticks: {
                font: { size: isMobile ? 9 : 10, family: 'ui-monospace, SF Mono, monospace' },
                color: 'rgba(35, 24, 21, 0.55)',
                maxRotation: 0,
              }
            },
            y: {
              beginAtZero: false,
              grace: '20%',
              grid: { color: 'rgba(46, 125, 50, 0.06)' },
              border: { display: false },
              ticks: {
                font: { size: isMobile ? 9 : 10, family: 'ui-monospace, SF Mono, monospace' },
                color: 'rgba(35, 24, 21, 0.55)',
                callback: (v: any) => `¥${v}`
              }
            }
          }
        } as any
      });
    }

    itemFilter.addEventListener('change', updateChart);
    marketFilter.addEventListener('change', updateChart);

    // 初期状態で最初の品目を選択
    if (items.length > 0) itemFilter.value = items[0];
    updateChart();

    // ============================================================
    // バックグラウンド refresh：SSGで埋め込んだデータの後に
    // 最新CSVを取りに行き、新しければ静かに上書きする
    // （SSG snapshot + client refresh の hybrid 構成）
    // ============================================================
    const S3_URL = "https://nouvation-market-preview.s3.ap-northeast-1.amazonaws.com/history.csv";
    const GAS_FALLBACK_URL = "https://script.google.com/macros/s/AKfycbyd_Or_Nxo2ZhqNk6GOo2btZ-uymgpJTU7kgE8bPWarWVTJ8bDX6QZW3YSD7Bij4Jvs/exec";

    function updateLastUpdatedIndicator(latestDateIso: string) {
      const el = document.getElementById('kpiLastUpdated');
      if (!el || !latestDateIso) return;
      const d = new Date(latestDateIso);
      if (isNaN(d.getTime())) return;
      el.textContent = `最終更新: ${d.getMonth() + 1}/${d.getDate()}`;
    }

    // CSV 1行 → セル配列
    function parseCsvLineClient(line: string): string[] {
      const cells: string[] = [];
      let current = "";
      let inQuotes = false;
      for (let i = 0; i < line.length; i++) {
        const ch = line[i];
        if (ch === '"') {
          if (inQuotes && line[i + 1] === '"') { current += '"'; i++; }
          else { inQuotes = !inQuotes; }
        } else if (ch === "," && !inQuotes) {
          cells.push(current);
          current = "";
        } else {
          current += ch;
        }
      }
      cells.push(current);
      return cells;
    }

    // ワイド形式CSV → Long形式（market.ts の parseWideSheet と同等ロジック）
    function parseWideSheetClient(text: string): MarketPrice[] {
      const result: MarketPrice[] = [];
      const lines = text.split(/\r?\n/);
      let headerIdx = -1;
      let headerCells: string[] = [];
      for (let i = 0; i < lines.length; i++) {
        const cells = parseCsvLineClient(lines[i]);
        if (cells[0] === "日付" || cells[0] === "date") {
          headerIdx = i;
          headerCells = cells;
          break;
        }
      }
      if (headerIdx === -1) return [];
      const dates = headerCells.slice(1).map(raw => {
        if (!raw) return null;
        const d = new Date(raw);
        if (isNaN(d.getTime())) return null;
        return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
      });
      const knownMarkets = new Set(['札幌市場','仙台市場','大田市場','名古屋市場','大阪市場','広島市場','福岡市場']);
      let currentMarket = '';
      for (let i = headerIdx + 1; i < lines.length; i++) {
        const cells = parseCsvLineClient(lines[i]);
        const first = cells[0]?.trim();
        if (!first) continue;
        if (first.endsWith('市場') || knownMarkets.has(first)) {
          currentMarket = first;
          continue;
        }
        if (!currentMarket) continue;
        const dataCells = cells.slice(1);
        for (let j = 0; j < dataCells.length && j < dates.length; j++) {
          const date = dates[j];
          if (!date) continue;
          const raw = dataCells[j].trim();
          if (!raw) continue;
          const price = Number(raw);
          if (!Number.isFinite(price) || price <= 0) continue;
          result.push({ date, item: first, market: currentMarket, price, unit: '円/kg' });
        }
      }
      return result;
    }

    async function refreshFromRemote() {
      let fresh: MarketPrice[] = [];
      try {
        const res = await fetch(S3_URL, { cache: 'no-cache' });
        if (!res.ok) throw new Error(`S3 HTTP ${res.status}`);
        fresh = parseWideSheetClient(await res.text());
      } catch (e) {
        console.warn('[market] S3 refresh failed, trying GAS fallback:', e);
        try {
          const res = await fetch(GAS_FALLBACK_URL, { redirect: 'follow' });
          if (!res.ok) throw new Error(`GAS HTTP ${res.status}`);
          fresh = parseWideSheetClient(await res.text());
        } catch (e2) {
          console.warn('[market] All refresh sources failed; keeping SSG data:', e2);
          return;
        }
      }
      if (fresh.length === 0) return;

      const currentLatest = prices.length > 0
        ? prices.reduce((a, b) => a.date > b.date ? a : b).date
        : '';
      const freshLatest = fresh.reduce((a, b) => a.date > b.date ? a : b).date;
      if (freshLatest <= currentLatest) {
        // SSG が既に最新と同等 → 何もしない
        return;
      }

      // 配列を mutate（updateChart クロージャ経由で同じ参照を見ているため）
      prices.length = 0;
      prices.push(...fresh);

      // フィルター選択肢を最新化（新しい品目/市場が登場した場合に備えて）
      const userItem = itemFilter.value;
      const userMarket = marketFilter.value;
      const newItems = [...new Set(prices.map(p => p.item))].filter(Boolean).sort();
      const newMarkets = [...new Set(prices.map(p => p.market))].filter(Boolean).sort();

      itemFilter.innerHTML = '';
      marketFilter.innerHTML = '';
      newItems.forEach(it => {
        const opt = document.createElement('option');
        opt.value = it;
        opt.textContent = it;
        itemFilter.appendChild(opt);
      });
      newMarkets.forEach(mk => {
        const opt = document.createElement('option');
        opt.value = mk;
        opt.textContent = mk;
        marketFilter.appendChild(opt);
      });
      // ユーザーの選択を可能な限り維持
      if (newItems.includes(userItem)) itemFilter.value = userItem;
      if (newMarkets.includes(userMarket)) marketFilter.value = userMarket;

      updateChart();
      updateLastUpdatedIndicator(freshLatest);
      console.log(`[market] Background refresh applied: ${currentLatest} → ${freshLatest}`);
    }

    // 初期インジケータ：まず SSG snapshot の最新日を表示
    const ssgLatest = prices.length > 0
      ? prices.reduce((a, b) => a.date > b.date ? a : b).date
      : '';
    if (ssgLatest) updateLastUpdatedIndicator(ssgLatest);

    // ページが見えてからバックグラウンド更新（初回レンダリングを邪魔しない）
    setTimeout(() => { refreshFromRemote(); }, 800);
  }

  // Astroのライフサイクルに合わせて初期化
  document.addEventListener('astro:page-load', initChart);
  // 初期読み込み時にも実行
  // 初回読み込み時にも実行
  initChart();

  // --- フォロワー数のカウントアップ・ギミック ---
  function initCountUp() {
    const target = document.getElementById('followerCount');
    if (!target) return;

    const finalValue = 30000;
    const duration = 2000;
    const frameRate = 1000 / 60;
    const totalFrames = Math.round(duration / frameRate);
    let currentFrame = 0;

    const observer = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting) {
        // グリッチ開始
        target.classList.add('glitch');
        setTimeout(() => target.classList.remove('glitch'), 300);

        const timer = setInterval(() => {
          currentFrame++;
          const progress = currentFrame / totalFrames;
          const easeOutQuad = 1 - (1 - progress) * (1 - progress);
          const currentValue = Math.floor(easeOutQuad * finalValue);

          target.textContent = currentValue.toLocaleString();

          if (currentFrame === totalFrames) {
            clearInterval(timer);
            // 完了時：上品なロックイン演出（スケール微変＋ライム下線シャイン）
            // 二重グリッチは廃止 → 数字が確定する「確かさ」を表現
            target.classList.add('glow');
            setTimeout(() => target.classList.remove('glow'), 900);
          }
        }, frameRate);

        observer.unobserve(target);
      }
    }, { threshold: 0.5 });

    observer.observe(target);
  }

  document.addEventListener('astro:page-load', initCountUp);
  initCountUp();

  // ============================================
  // Instagram embed.js 遅延ロード（IntersectionObserver）
  // 全ての Instagram 埋め込みゾーンを対象に、画面接近時のみ embed.js をロード
  // ============================================
  function initInstagramLazyLoad() {
    const zoneIds = ['instagram-embed-zone', 'farmatch-instagram-zone'];
    const zones = zoneIds
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);
    if (zones.length === 0) return;

    let loaded = false;
    const loadInstagramScript = () => {
      if (loaded) return;
      loaded = true;
      // 既存スクリプトの重複読み込みを防止
      if (document.querySelector('script[src*="instagram.com/embed.js"]')) {
        // 既に読込済みなら即 process
        const w = window as any;
        if (w.instgrm && w.instgrm.Embeds) w.instgrm.Embeds.process();
        return;
      }
      const s = document.createElement('script');
      s.src = 'https://www.instagram.com/embed.js';
      s.async = true;
      s.onload = () => {
        // スクリプト読込後、ページ内の全 blockquote を Instagram に渡す
        const w = window as any;
        if (w.instgrm && w.instgrm.Embeds) {
          w.instgrm.Embeds.process();
        }
        // 全ゾーンのスケルトンを外す
        document
          .querySelectorAll('.ig-skeleton, .ig-skeleton-fm')
          .forEach((el) => el.classList.remove('ig-skeleton', 'ig-skeleton-fm'));
      };
      document.body.appendChild(s);
    };

    // IntersectionObserver で 200px 手前から先読み
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            loadInstagramScript();
            io.disconnect();
          }
        });
      }, { rootMargin: '200px' });
      zones.forEach((zone) => io.observe(zone));
    } else {
      // 古いブラウザ用フォールバック：即時ロード
      loadInstagramScript();
    }
  }

  document.addEventListener('astro:page-load', initInstagramLazyLoad);
  initInstagramLazyLoad();
</script>

