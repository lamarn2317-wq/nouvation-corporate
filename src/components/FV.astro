---
// First View Component
---

<section data-section-theme="dark" class="relative h-screen flex items-center justify-center overflow-hidden">
  <!-- Opening Animation Overlay -->
  <div id="opening-overlay" class="absolute inset-0 z-[100] bg-[#111111] flex items-center justify-center pointer-events-none">
    <div id="opening-line" class="opening-line w-full h-[1px] bg-[#2ea854] scale-x-0 origin-left"></div>
  </div>

  <!-- Background Video -->
  <video 
    id="fv-video"
    muted 
    loop 
    playsinline
    class="absolute inset-0 w-full h-full object-cover"
    aria-label="農業の風景"
  >
    <source src="https://res.cloudinary.com/djlmck6yb/video/upload/v1770521401/fv_v2_o1balh.mp4" type="video/mp4" />
  </video>
  
  <!-- Background Layers -->
  <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-[#111111]"></div>
  
  <!-- Content -->
  <div id="fv-content" class="relative z-[110] text-center px-4 max-w-5xl mx-auto">
    <h1 id="fv-title" class="font-serif font-bold text-white tracking-wider opacity-0 scale-[0.97] block text-[2.8rem] md:text-[4.5rem]" style="line-height: 1.2; font-family: 'Shippori Mincho', 'YuMincho', 'Yu Mincho', 'Hiragino Mincho ProN', 'MS PMincho', serif;" >
      農業界に、情報で革新を。
    </h1>
    <p id="fv-desc" class="text-base md:text-2xl font-medium text-[#E5E7EB] leading-loose mt-6 opacity-0 translate-y-4">
      農家が報われる社会を、情報とつながりで実現する<br class="hidden md:block" />
      <span class="text-white">次世代の農業インフラメディア</span>
    </p>
  </div>
</section>

<style>
  .opening-line {
    animation: line-shuin 1.0s cubic-bezier(0.65, 0, 0.35, 1) forwards;
  }

  .opening-line.fade-out {
    opacity: 0;
    transition: opacity 0.5s ease-out;
  }

  @keyframes line-shuin {
    0% { transform: scaleX(0); }
    100% { transform: scaleX(1); }
  }

  #opening-overlay.fade-out {
    opacity: 0;
    transition: opacity 1.5s ease-in-out;
  }

  /* タイトルのズームアニメーション */
  #fv-title.zoom-in {
    opacity: 1 !important;
    transform: scale(1) !important;
    transition: opacity 2s ease-out, transform 4s cubic-bezier(0.1, 0, 0.2, 1) !important;
  }

  /* 説明文のフェードイン */
  #fv-desc.fade-in {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 1.2s ease-out;
  }
</style>

<script>
  function initFVAnimation() {
    const overlay = document.getElementById('opening-overlay');
    const line = document.getElementById('opening-line');
    const title = document.getElementById('fv-title');
    const desc = document.getElementById('fv-desc');
    const video = document.getElementById('fv-video') as HTMLVideoElement;
    
    if (!overlay || !line || !title || !desc) return;

        // 4. タイトルのズームが進んだ後（0.8秒後）に背景動画をフェードイン開始
        setTimeout(() => {
          overlay.classList.add('fade-out');
          
          if (video) {
            video.play().catch(e => console.error("Video play error:", e));
          }
          
          // 5. 背景が見え始めた後に説明文を表示
          setTimeout(() => {
            desc.classList.add('fade-in');
          }, 600);

          setTimeout(() => {
            overlay.style.display = 'none';
          }, 1200);
        }, 800); // 1500msから800msにさらに短縮
      }, 100); 
    }, 400); // 600msから400msに短縮
  }

  // Astroの遷移対応
  document.addEventListener('astro:page-load', initFVAnimation);
  // 初回実行
  initFVAnimation();
</script>