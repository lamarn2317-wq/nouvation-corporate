---
// First View Component
---

<section data-section-theme="dark" class="relative h-screen flex items-center justify-center overflow-hidden">
  <!-- Background Video -->
  <video 
    autoplay 
    muted 
    loop 
    playsinline
    class="absolute inset-0 w-full h-full object-cover"
    aria-label="農業の風景"
  >
    <source src="https://res.cloudinary.com/djlmck6yb/video/upload/v1770521401/fv_v2_o1balh.mp4" type="video/mp4" />
  </video>
  
  <!-- Background Layers -->
  <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-[#111111]"></div>
  
  <!-- Content -->
  <div class="relative z-10 text-center px-4 max-w-5xl mx-auto">
    <h1 id="fv-title" class="font-serif font-bold text-white tracking-wider opacity-0 translate-y-6 transition-all duration-[3000ms] ease-out block text-[2.8rem] md:text-[4.5rem]" style="line-height: 1.2; font-family: 'Shippori Mincho', 'YuMincho', 'Yu Mincho', 'Hiragino Mincho ProN', 'MS PMincho', serif;" >
      農業界に、情報で革新を。
    </h1>
    <p class="text-base md:text-2xl font-medium text-[#E5E7EB] leading-loose mt-6">
      農家が報われる社会を、情報とつながりで実現する<br class="hidden md:block" />
      <span class="text-white font-bold">次世代の農業インフラメディア</span>
    </p>
  </div>
</section>

<script>
  function initFVAnimation() {
    const title = document.getElementById('fv-title');
    if (!title) return;

    // ページ読み込みから少し遅らせてアニメーション開始
    setTimeout(() => {
      title.classList.remove('opacity-0', 'translate-y-6'); // HTMLの数値と合わせる
      title.classList.add('opacity-100', 'translate-y-0');
    }, 1500);
  }

  // Astroの遷移対応
  document.addEventListener('astro:page-load', initFVAnimation);
  // 初回実行
  initFVAnimation();
</script>