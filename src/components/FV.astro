---
// First View Component
---

<section data-section-theme="dark" class="fv-stable relative flex items-center justify-center overflow-hidden">
  <!-- Opening Animation Overlay -->
  <div id="opening-overlay" class="absolute inset-0 z-[100] bg-[#111111] flex items-center justify-center pointer-events-none">
    <div id="opening-line" class="opening-line w-full h-[1px] bg-[#2ea854] scale-x-0 origin-left"></div>
  </div>

  <!-- Background Video (PC & SP 共通 — MP4で統一) -->
  <video
    id="fv-video"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    poster="/images/fv_poster.jpg"
    class="absolute inset-0 w-full h-full object-cover"
    aria-label="農業の風景"
  >
    <source src="/videos/fv_v4.mp4" type="video/mp4" />
  </video>
  
  <!-- Background Layers -->
  <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-[#111111]"></div>
  
  <!-- Content -->
  <div id="fv-content" class="relative z-[110] text-center px-4 max-w-5xl mx-auto">
    <h1 id="fv-title" class="font-serif font-bold text-white max-md:tracking-tight md:tracking-wider opacity-0 scale-[0.97] block md:text-[4.5rem] max-md:leading-[1.45] max-md:pl-[1.15rem] max-md:pr-[0.55rem] ja-keep" style="line-height: 1.2; font-family: 'Shippori Mincho', 'YuMincho', 'Yu Mincho', 'Hiragino Mincho ProN', 'MS PMincho', serif;" >
      農業界に、情報で革新を。
    </h1>
    <p id="fv-desc" class="text-sm md:text-2xl font-medium text-white leading-loose mt-6 opacity-0 translate-y-4 ja-keep">
      <span class="text-white">農家が報われる社会を、<br class="md:hidden" />情報とつながりで実現する</span><br />
      <span class="text-white">次世代農業インフラメディア</span>
    </p>
  </div>

  <!-- Scroll Indicator -->
  <div id="fv-scroll" class="absolute bottom-20 left-1/2 -translate-x-1/2 z-[110] flex flex-col items-center opacity-0 transition-opacity duration-1000">
    <span class="text-white/60 text-xs md:text-[10px] uppercase tracking-[0.16em] md:tracking-[0.2em] mb-2 font-display">Scroll</span>
    <div class="w-[2px] h-16 relative overflow-hidden">
      <div class="scroll-line-inner absolute top-0 left-0 w-full h-full bg-gradient-to-b from-white to-transparent"></div>
    </div>
  </div>
</section>

<style>
  /* FV メインタイトル：モバイルで全機種 1 行に収まる fluid sizing */
  @media (max-width: 767px) {
    #fv-title {
      font-size: clamp(1.4rem, 7.0vw, 1.85rem) !important;
    }
  }

  /* FVの高さを安定化（URLバーの表示/非表示で動かない） */
  .fv-stable {
    height: 100vh;
    /* スクロール時のURLバー変化で高さが変わらないよう svh を使用（対応ブラウザ） */
    height: 100svh;
    min-height: 600px;
  }

  .opening-line {
    animation: line-shuin 1.0s cubic-bezier(0.65, 0, 0.35, 1) forwards;
  }

  .opening-line.fade-out {
    opacity: 0;
    transition: opacity 0.5s ease-out;
  }

  @keyframes line-shuin {
    0% { transform: scaleX(0); }
    100% { transform: scaleX(1); }
  }

  #opening-overlay.fade-out {
    opacity: 0;
    transition: opacity 1.5s ease-in-out;
  }

  /* タイトルのズームアニメーション */
  #fv-title.zoom-in {
    opacity: 1 !important;
    transform: scale(1) !important;
    transition: opacity 3.5s ease-out, transform 4s cubic-bezier(0.1, 0, 0.2, 1) !important;
  }

  /* 説明文のフェードイン */
  #fv-desc.fade-in {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 1.2s ease-out;
  }

  /* スクロール線の動くアニメーション */
  .scroll-line-inner {
    animation: scroll-line-anim 2.5s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  @keyframes scroll-line-anim {
    0% { transform: translateY(-100%); }
    50% { transform: translateY(0); }
    100% { transform: translateY(100%); }
  }
</style>

<script>
  let fvAnimationStarted = false;

  function initFVAnimation() {
    if (fvAnimationStarted) return;
    fvAnimationStarted = true;

    const overlay = document.getElementById('opening-overlay');
    const line = document.getElementById('opening-line');
    const title = document.getElementById('fv-title');
    const desc = document.getElementById('fv-desc');
    const scroll = document.getElementById('fv-scroll');
    const video = document.getElementById('fv-video') as HTMLVideoElement;

    if (!overlay || !line || !title || !desc) return;

    // 1. 横線アニメーションが完了するのを確実に待つ
    line.addEventListener('animationend', () => {
      // 2. 線をフェードアウトさせる
      line.classList.add('fade-out');

      // 3. 線が消え始めたらすぐにタイトルのズームアニメーションを開始
      setTimeout(() => {
        title.style.opacity = "1";
        title.classList.add('zoom-in');

        // 4. タイトルのズームが進んだ後（0.8秒後）に背景動画をフェードイン開始
        setTimeout(() => {
          overlay.classList.add('fade-out');

          if (video) {
            video.muted = true;
            const playPromise = video.play();
            if (playPromise !== undefined) {
              playPromise.catch(e => {
                console.warn("Autoplay was prevented, retrying...", e);
                video.muted = true;
                video.play().catch(err => console.error("Final play error:", err));
              });
            }
          }

          // 5. 背景が見え始めた後に説明文を表示
          setTimeout(() => {
            desc.classList.add('fade-in');
            if (scroll) scroll.style.opacity = "1";
          }, 600);

          setTimeout(() => {
            overlay.style.display = 'none';
          }, 1200);
        }, 800);
      }, 100);
    }, { once: true });
  }

  // Astroの遷移対応
  document.addEventListener('astro:page-load', () => {
    fvAnimationStarted = false;
    initFVAnimation();
  });
  // 初回実行
  initFVAnimation();
</script>
