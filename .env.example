# ====================================
# NOUVATION サイト 環境変数サンプル
# ====================================
# このファイルをコピーして `.env` を作成し、実際の値を入れてください。
# Vercel 本番デプロイでは Vercel ダッシュボードの
# Project Settings → Environment Variables に同じキーを設定してください。
# ====================================

# === MicroCMS（News セクション用・任意）===
MICROCMS_SERVICE_DOMAIN=your-service-domain
MICROCMS_API_KEY=your-api-key

# === その他の環境変数（必要に応じて）===
SITE_URL=https://nouvation.com

# === Resend（お問い合わせフォーム用・本番必須）===
# 取得方法: https://resend.com にアカウント作成 → API Keys → Create API Key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# === メール送信設定（お問い合わせフォーム用）===
# 通知メール送信先（NOUVATION 側で受け取るアドレス）
CONTACT_EMAIL_TO=info@nouvation-official.com

# 送信元アドレス（Resend で検証済みのドメインを使う必要あり）
# テスト時は "onboarding@resend.dev" でも送れる（ドメイン検証なしで動く）
# 本番では "NOUVATION <info@nouvation-official.com>" 推奨
CONTACT_EMAIL_FROM=NOUVATION <onboarding@resend.dev>

# 自動返信メールの Reply-To（受信者が返信した時の送信先）
CONTACT_EMAIL_REPLY_TO=info@nouvation-official.com
